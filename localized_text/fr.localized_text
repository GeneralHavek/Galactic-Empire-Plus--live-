    "sw_constructor_ship_name": "Y-45 Orbital Frigate",
    "sw_constructor_ship_description": "A civilian orbital frigate equipped with many assembly tools, it builds structures within range of the planet.",
    "sw_trade_complex_name": "Carden Trade Complex",
    "sw_trade_complex_description": "Build Trade Ports to increase global Export Points and Export types. Allocate Export Points between Export types to customize your economy. Goods increase credit income while metal and crystal increase resource income.",

    "imperial_faction_victory_unit_item_name": "Imperial Supremacy",
    "imperial_faction_victory_unit_item_description": "The Emperor himself sits on his throne in the control room. All will bow before the power of this fully armed and operational battlestation.",
    "imperial_unlock_faction_victory_item_research_subject_name": "Imperial Supremacy",
    "imperial_unlock_faction_victory_item_research_subject_name_uppercase": "IMPERIAL SUPREMACY",
    "imperial_superlaser_ability_name": "Full Reactor Ignition",
    "imperial_superlaser_ability_desc": "The DS-1 Orbital Battlestation's massive antimatter annihilator reactors are momentarily overcharged to fill massive capacitors capable of holding at least a week's worth of output from a yellow dwarf star. This power is pushed through the power diversion solenoid and directed into the eight reactor lenses lining its large dish, firing a powerful beam capable of destroying the gravitational binding energy of a planet. These massive reactors also power a multitude of weapons systems and particularly resilient deflector shields. A hammer in a universe of nails.",
    "imperial_allegiance_power_surge_ability_name": "Prototype Shield Overcharge Array",
    "imperial_allegiance_power_surge_ability_description": "The Allegiance is the most powerful ship the Empire can field, thus it must be protected. A new prototype shield array was developed using enemy technology and superior Imperial designs. While the battlecruiser still has antimatter reserves, its shields will remain powerful.",
    "imperial_venator_sphat_ability_name": "Turbolaser SPHA-T",
    "imperial_garrison_ability_name": "Garnison Planetaire",
    "imperial_garrison_ability_description": "Envois un détachement de Stormtroopers pour assurer la conformité planétaire aux lois impériales.",
    "imperial_power_weapons_ability_name": "Dériver l'Énergie vers les Armes",
    "imperial_power_weapons_ability_description": "Redirige l’énergie des boucliers pour accélérer le cycle de tir des armes.",
    "imperial_jump_disruption_ability_name": "Generateur de Puits Gravitationnel",
    "imperial_jump_disruption_ability_description": "Interfère avec les hyperpropulseurs des vaisseaux ennemis dans la zone, les empêchant de s’échapper.",
    "ability_ion_blast_name": "Explosion Ionique",
    "ability_ion_blast_desc": "Tir ionique concentré et intense qui désactivera un vaisseau ennemi temporairement.",
    "imperial_base_delta_zero_ability_name": "Base Delta Zero",
    "imperial_base_delta_zero_ability_description": "Bombardement orbital jusqu'à l'annihilation totale de toute résistance.",
    "imperial_research_lab_structure_phase_lane_detector_ability_name": "Protocoles d'Alerte Précoce de l'ISB",
    "imperial_research_lab_structure_phase_lane_detector_ability_description": "Le Bureau de Sécurité Impérial surveille les communications en subluminique et en hyperespace pour détecter l’arrivée de vaisseaux de guerre hostiles.",
    "imperial_flak_splash_item_name": "Canons Flak",
    "imperial_flak_splash_unit_item_description": "Canons flak équipés d'obus explosifs chargés de fléchettes en duracier, capables de déchiqueter les chasseurs stellaires et les missiles ennemis avec facilité.",
    "imperial_pelta_shield_projection_ability_name": "Projecteur de Bouclier Déflecteur",
    "imperial_pelta_shield_projection_ability_description": "Le Pelta utilise des réseaux déflecteurs spécialisés pour renforcer les boucliers des vaisseaux alliés autour de lui et répartir les dégâts entrants avec ses propres boucliers.",
    "imperial_arquitens_command_center_ability_name": "Algorithmes de Combat Efficaces",
    "imperial_arquitens_command_center_ability_description": "Le Croiseur de Commandement Arquitens est équipé de liaisons de ciblage spécialisées. Tous les vaisseaux à portée combinent leur puissance de calcul pour améliorer la précision des tirs et réinjecter l’excédent d’énergie inutilisée dans leurs réserves d’antimatière.",
    "imperial_strikecraft_ability_dodge_name": "Programme de Formation des Pilotes Vétérans",
    "imperial_strikecraft_ability_dodge_description": "L'Empire a mis en place de nouveaux programmes de formation intensive pour les pilotes existants et recrues, leur permettant d'exploiter plus efficacement la ligne de chasseurs TIE. Les rapports indiquent que les pilotes entraînés pourront éviter les batteries de défense ponctuelle avec un bien meilleur taux de réussite.",
    "imperial_venator_hangar_capacity_ability_name": "Carrier Doctrine",
    "imperial_venator_hangar_capacity_ability_description": "Opens the Venator's full flight deck and expands carrier operations, increasing its ability to launch, replace, and sustain strikecraft squadrons.",

    "imperial_auxiliary_supply_depot_unit_item_name": "Sector Axiliary Supply Depot",
    "imperial_auxiliary_supply_depot_unit_item_description": "Establishes a dedicated supply hub to extend the operational range of auxiliary forces loyal to the Empire.",

    "imperial_planetary_shield_array_unit_item_name": "SDL-26 Planetary Shield Generator",
    "imperial_planetary_shield_array_unit_item_description": "A hold-over of previous tech used by the Galactic Empire. Repurposed and refit with new materials found here in this new universe. Casts a planet-wide defensive shield.",
    "imperial_emperors_will_unit_item_name": "Emperor's Will",
    "imperial_emperors_will_unit_item_description": "The very will of the Emperor extends his influence to far-off planets, requiring only the presence of the Imperial Navy to take effect. Even corruption serves his designs, as ambition, intrigue, and institutional decay are turned to the advantage of those who remain instruments of his will. Long live the Empire!",
    "imperial_vaders_gaze_unit_item_name": "Vader's Gaze",
    "imperial_vaders_gaze_unit_item_description": "Few things inspire greater diligence among Imperial officers than the knowledge that Darth Vader's attention has fallen upon them. Under his unforgiving scrutiny, hesitation gives way to decisive action, incompetence is swiftly corrected, and corruption is met with consequences few are willing to risk.",
    
    "unit_item_upkeep_reduction_name": "Advanced Logistics Protocols",
    "unit_item_upkeep_reduction_description": "Specialized protocols are inacted on the ship resulting in a marked decrease in resource waste and upkeep.",
    "unit_item_vrip_name": "V-RIP : Venator - Programme de Rétrofit et d'Amélioration",
    "unit_item_vrip_desc": "Programme de prolongation de la durée de vie visant à améliorer les capacités du vénérable Venator. Cette modernisation double la batterie principale de turbolasers DBY-827, ajoute des emplacements de canons ioniques vers la proue et améliore la survivabilité du vaisseau.",
    "imperial_starbase_gravity_generator_unit_item_name": "Générateur de Gravité Classe-B",
    "imperial_starbase_gravity_generator_unit_item_description": "Grâce à l’utilisation de nouveaux matériaux exotiques, les générateurs de puits gravitationnels peuvent désormais être installés sur les avant-postes de Classe-B sans drain énergétique supplémentaire significatif.",
    "imperial_specialization_offense_firing_speed_unit_item_name": "Solutions de Ciblage à Tir Rapide",
    "imperial_specialization_offense_firing_speed_unit_item_description": "Un algorithme améliorant la cadence de tir des turbolasers et des canons ioniques pour tirer plus rapidement sur la cible avec un temps d'acquisition réduit, mais diminuant la portée et la puissance globale.",
    "imperial_specialization_offense_damage_range_unit_item_name": "Algorithme de Ciblage à Haute Intensité",
    "imperial_specialization_offense_damage_range_unit_item_description":"Un algorithme améliorant les capacités de frappe initiale des turbolasers et canons ioniques en réduisant la cadence des convertisseurs de puissance.",
    "imperial_specialization_offense_exploit_weakness_unit_item_name": "Algorithme de Modulation de Fréquence Amélioré",
    "imperial_specialization_offense_exploit_weakness_unit_item_description": "Un algorithme permettant une fluctuation accrue de la fréquence des tirs de turbolasers et de canons ioniques, rendant de nombreux tirs capables de contourner totalement les boucliers ennemis, au prix d'une réduction de la cadence de tir et de la puissance globale.",
    "imperial_specialization_defense_generator_unit_item_name": "Matrice d'Intégrité du Bouclier Déflecteur",
    "imperial_specialization_defense_hull_and_armor_item_unit_name": "Blindage Juggernaut",
    "imperial_specialization_defense_hull_and_armor_item_unit_description": "De nouvelles menaces émergent, nécessitant un renforcement supplémentaire de la superstructure des vaisseaux impériaux. Les boucliers déflecteurs ne protègent que partiellement contre cet ennemi.",
    "imperial_specialization_defense_generator_unit_item_description": "Les condensateurs des boucliers déflecteurs sont continuellement renforcés, augmentant leur intégrité et permettant un regain d'énergie ramenant partiellement les boucliers tombés en panne en ligne après un court délai.",
    "imperial_defense_culture_research_subject_name": "Parades Militaires",
    "imperial_defense_culture_research_subject_name_uppercase": "PARADES MILITAIRES",
    "imperial_defense_culture_research_subject_description": "Les célébrations militaires et parades obligatoires fréquentes assurent une diffusion maximale des messages impériaux à tous les êtres vivants, qu’ils soient citoyens ou étrangers.",
    "imperial_deploy_starbase_unit_item_name": "Déploiement d'un Avant-Poste Classe-B",
    "imperial_deploy_starbase_unit_item_description": "Permet le déploiement tactique d'un avant-poste de Classe-B dans un puits gravitationnel neutre ou contesté.",
    "imperial_gas_harvester_unit_item_name": "Colonie Minière Flottante",
    "imperial_gas_harvester_unit_item_description": "Ces cités flottantes, à l’image de la Cité des Nuages de Bespin, sont en réalité des raffineries filtrant les gaz planétaires pour en extraire des matériaux exploitables à des fins militaires et économiques.",
    "imperial_gas_crystalizer_unit_item_name": "Dépot de Filtration Avancée",
    "imperial_gas_crystalizer_unit_item_description": "Des systèmes de filtration supplémentaires, combinés à des techniques de construction avancées, permettent l’accumulation progressive de matériaux exotiques spécialisés.",
    "imperial_strip_mining_unit_item_name": "Excavateurs de la Guilde Minière",
    "imperial_strip_mining_unit_item_description": "L'Empire Galactique maîtrise parfaitement l'extraction intensive des ressources planétaires. Les excavateurs de la Guilde Minière sont modifiés pour fonctionner dans n'importe quel environnement atmosphérique.",
    "imperial_command_bunker_unit_item_name": "Garnison Avancée de Stormtroopers",
    "imperial_command_bunker_unit_item_description": "Un détachement de stormtroopers destiné à renforcer la défense d'une planète donnée.",
    "imperial_crystal_mines_unit_item_name": "Exploitation des Cristaux",
    "imperial_crystal_mines_unit_item_description": "La Guilde Minière a reçu l’autorisation d’extraire des gisements de cristaux profondément enfouis dans la croûte planétaire, renforçant ainsi l’exploitation des planètes cristallines.",
    "imperial_ferric_mines_unit_item_name": "Exploitation des Gisements Ferriques",
    "imperial_ferric_mines_unit_item_description": "La Guilde Minière a reçu l’autorisation d’extraire des gisements de fer profondément enfouis dans la croûte planétaire, renforçant ainsi l’exploitation des planètes riches en fer.",
    "imperial_kessel_mines_unit_item_name": "Administration des Mines de Kessel",
    "imperial_kessel_mines_unit_item_description": "Tout a besoin d'une infrastructure administrative pour fonctionner efficacement. Les rééduqués aspirent aux mines.",
    "imperial_homeworld_heart_of_the_galaxy_name": "Heart of the Galaxy",
    "imperial_homeworld_heart_of_the_galaxy_description": "Though the Empire was cast from our original home, our legacy will not be one of defeat or mediocrity. Our leader will ensure our prosperity. Long live the Empire.",
    "imperial_orbital_targeting_computer_unit_item_name": "Orbital Targeting Computer",
    "imperial_orbital_targeting_computer_unit_item_description": "Specialized targeting computers capable of networking with allied ships are installed to increase the amount of devastation inflicted by our bombardments on enemy planets.",
    "imperial_lancer_name": "Lancer-class Frigate",
    "imperial_lancer_name.garrison": "Garrison Lancer-class Frigate",
    "imperial_lancer_description": "Lancer-class frigates are purpose built to cut through starfighters and are the best anti-starfighter vessels in the galaxy.",
    "imperial_velox_name": "Velox-class Frigate",
    "imperial_velox_name.garrison": "Garrison velox-class Frigate",
    "imperial_velox_description": "The Velox-class Frigate was designed to supplement, and replace in some cases, the Arquiten-class Frigate.",
    "imperial_tie_fighter_name": "TIE Fighter",
    "imperial_tie_fighter_description": "TIE/ln Fighters are cheap to mass produce and are effective in large numbers.",
    "imperial_tie_interceptor_name": "TIE Interceptor",
    "imperial_tie_interceptor_description": "TIE/in Interceptors faster and more nimble than the TIE/ln. Their increased number of laser cannons allow them to cut through fighters and bombers with impunity",
    "imperial_tie_defender_name": "TIE Defender",
    "imperial_tie_defender_description": "TIE/D Fighters are advanced and effective space superiority fighters. Their shields substantially increase pilot survivability but cannot be fielded in large numbers due to logistical costs.",
    "imperial_tie_bomber_name": "TIE Bomber",
    "imperial_tie_bomber_description": "TIE/sa Bombers are slow and armored, specializing in attacking facilities and large starships.",
    "imperial_tr_galleon_name": "Galleon",
    "imperial_tr_galleon_description": "",
    "imperial_procursator_name": "Procursator-class Star Destroyer",
    "imperial_procursator_name.garrison": "Garrison Procursator-class Star Destroyer",
    "imperial_procursator_loot_name": "Procursator Wreckage",
    "imperial_procursator_description": "A little known Star Destroyer design pulled from the archives with comparable firepower to the newer ISDs but with much less defensive armor and shielding. Every viable design is needed in this new conflict.",
    "imperial_allegiance_name": "Allegiance-class Battlecruiser",
    "imperial_allegiance_loot_name": "Allegiance Wreckage",
    "imperial_allegiance_description": "Allegiance-class Battlecruisers are powerful warships with numerous weapon batteries and are optimized for ship-to-ship combat. One can have a total of 2 of these vessels at any given time.",
    "imperial_immobilizer_name": "Immobilizer 418-class Star Destroyer",
    "imperial_immobilizer_description": "The Immobilizer 418-class is a modified Vindicator-class Star Destroyer. It possesses four powerful gravity field generators capable of preventing enemy ships from escaping to hyperspace. In addition, its light armament allows for limited anti-starfighter and anti-frigate operations.",
    "imperial_interdictor_name": "Interdictor-class Star Destroyer",
    "imperial_interdictor_description": "",
    "imperial_gunpod_name": "Orbital Defense Tower",
    "imperial_gunpod_description": "A cheap orbital module deployed to defend planets from small fleets. Originally equipped with two heavy turbolaser turrets and four medium turbolaser turrets, it can also be retrofitted with concussion missile pods.",
    "imperial_starbase_name": "Class-B Military Outpost",
    "imperial_starbase_loot_name": "Class-B Wreckage",
    "imperial_starbase_description": "While the Empire has many orbital structure designs, the Class-B Outpost has the size, durability, power, and modularity needed to defend any gravity well from most threats.",
    
    "pirate_lucrehulk_name": "Lucrehulk-class Battleship",
    "pirate_lucrehulk_loot_name": "Lucrehulk Wreckage",
    "pirate_lucrehulk_description": "This converted freighter is bristling with weapon emplacements and is the most powerful capital ship in the CIS' arsenal. It also has an extremely large hangar space allowing for the deployment of a substantial number of fighters and bombers.",
    "pirate_munificent_name": "Munificent-class Frigate",
    "pirate_munificent_description": "Munificent-class star frigates are used for communications and ECM warfare and have a massive prow Turbolaser cannon and dual Ion cannon that is lethal against single targets, even those many times the Munificent's size.",
    "pirate_xx777_name": "XX-777 Corvette",
    "pirate_xx777_description": "Also known as the triple seven, the XX-777 is a favorite ship of pirates, criminal organziations, and freedom fighters.",
    "pirate_kihraxz_name": "Kihraxz Interceptor",
    "pirate_kihraxz_description": "The Kihraxz Interceptor is a fast and durable interceptor favored by pirates and some freedom fighters.",
    "pirate_t62_name": "T62 Convor",
    "pirate_t62_description": "The direct precursor to the T65 X-wing by Incom. It featured upgraded engines and shields over the Z-95 Headhunter as well as a cluster of concussion missile tubes on each wing for increased lethality against hard targets.",
    "pirate_aggressor_name": "Aggressor-class Destroyer",
    "pirate_aggressor_loot_name": "Agressor-class Wreckage",
    "pirate_aggressor_description": "This destroyer was the underworld's answer to the Imperial Star Destroyer. It possesses two powerful dorsal plasma turbocannons giving it awesome alpha strike capabilities and sacrifices any potential hangar volume to field a greater number of turbolasers. It additionally has four twin barrel Mass Driver turrets for additional capital ship combat power.",
    "pirate_vengeance_name": "Vengeance-class Frigate",
    "pirate_vengeance_description": "A frigate in name only, this vessel possesses the firepower to punch well above its weight. Its two twin-linked gatling mass driver turrets have the ability to quickly rip through shields and hull alike.",
    "pirate_ysalamiri_name": "Ysalamiri-class cruiser",
    "pirate_ysalamiri_description": "An older Mando Motors design with an impressive array of firepower. It is more than a match for larger, newer ships with its powerful shields and numerous weapon systems.",
    "pirate_rill_name": "Rill-class Corvette",
    "pirate_rill_name.garrison": "Garrison Rill-class Corvette",
    "pirate_rill_description": "Mandal Motors built the Rill-class corvette to be the epitome of scouting and reconnaissance, while also possessing superior firepower for its class.",
    "pirate_keldabe_name": "Keldabe-class Battleship",
    "pirate_keldabe_loot_name": "Keldabe Wreckage",
    "pirate_keldabe_description": "A hybrid assault vessel, the Keldabe Battlecruiser merges the role of a heavy combatant with limited carrier support. Its design prioritizes sustained pressure and battlefield endurance, allowing it to overwhelm opponents through layered firepower and relentless engagement.",
    "pirate_mining_frigate_name": "HJ-45 Mining Frigate",
    "pirate_mining_frigate_name.garrison": "Garrison HJ-45 Mining Frigate",
    "pirate_mining_frigate_description": "A refitted mining vessel with a sturdy construction capable of forming the back-bone of a defense fleet, it is prized due to its relative cheap cost and semi-modular construction.",
    "pirate_bulwark_name": "Bulwark-Class Support Frigate",
    "pirate_bulwark_description": "Originally produced by SoroSuub Corporation as a modular convoy support platform, the Bulwark-class was rapidly adopted and modified by independent trade coalitions and syndicate fleets.",
    "pirate_deuteros_name": "Deuteros-class Cruiser",
    "pirate_deuteros_description": "Commissioned by Pantora to protect distant commercial interests, the Deuteros-class Cruiser combines exceptional firepower with long-range endurance. Surplus vessels have since found new life among independent traders and syndicate fleets seeking a warship capable of defending valuable cargo and projecting authority across contested space.",
    "pirate_rupture_name": "Rupture-class Support Cruiser",
    "pirate_rupture_description": "Originally developed with assistance from SoroSuub Corporation for long-range convoy support, the Rupture-class combines fleet coordination systems, disabling ion weaponry, and robust defensive armament. Its versatility and reliability have made it a favored support vessel among independent traders and syndicate fleets operating far from established authority.",

    "imperial_golan1_name": "Golan-1 Space Defense Platform",
    "imperial_golan1_description": "The Golan-1 defense platform was engineered to provide a powerful orbital defense hangar with equivalent firepower to a Star Destroyer.",
    "imperial_kontos_name": "Kontos-class Frigate",
    "imperial_kontos_name.garrison": "Garrison Kontos-class Frigate",
    "imperial_kontos_description": "Kontos-class Frigates are a small but powerful new addition to the Imperial Navy. It sports powerful turbolasers for larger targets and laser cannons for smaller more agile targets.",
    "imperial_gladiator_name": "Gladiator-class Star Destroyer",
    "imperial_gladiator_description": "The next evolution in imperial carrier design, the Gladiator is the successor to the Venator. While classified as a cruiser, it retains an expansive hangar bay and can hold it's own against capital class ships.",
    "imperial_pelta_name": "Pelta-class Frigate",
    "imperial_pelta_name.garrison": "Garrison Pelta-class Frigate",
    "imperial_pelta_description": "The Pelta-class Frigate was the versatile workhorse of the Old Republic Navy, fitting into many roles. It has now been repurposed to provide the Imperial Navy much needed fleet support and fighter screens, while also be effective against smaller cruisers and any frigates it might come across.",
    "imperial_culture_center_structure_name": "Holonet Array",
    "imperial_culture_center_structure_description": "An orbital platform with the sole purpose of increasing pro-Imperial sentiment and suppressing misinformation.",
    
    "imperial_shipyard_name": "Orbital Shipyard",
    "imperial_shipyard_description": "Allows construction of corvettes, frigates, and cruisers.",
    "imperial_heavy_shipyard_name": "Heavy Orbital Shipyard",
    "imperial_heavy_shipyard_description": "Allows construction of capital ships",
    "imperial_death_star_name": "DS-1 Orbital Battle Station",
    "imperial_death_star_loot_name": "DS-1 Orbital Battle Station Wreckage",
    "imperial_death_star_description": "The DS-1, known also as the Death Star, is the pinnacle of Imperial Battlestation techology. It possesses equivalent firepower to an entire fleet and can obliterate planets with its Mark I superlaser. As kyber crystals cannot be found here in this new universe, the focusing crystals were replaced using new and powerful exotic materals.",
    "imperial_executor_name": "Executor-class Super Star Destroyer",
    "imperial_executor_loot_name": "Executor-class Super Star Destroyer Wreckage",
    "imperial_executor_description": "The ultimate form of the Empire's naval power. The Executor-class Super Star Destroyer serves not only as a iron fisted gauntlet to crush opposition, but as a mobile naval command capable of increasing the combat effectiveness of surrounding Imperial vessels.",
    "imperial_executor_pd_unit_item_name": "Aegis Defense Refit",
    "imperial_executor_pd_unit_item_description": "The Executor is reconfigured around a comprehensive close-defense doctrine, prioritizing layered point-defense coverage over offensive specialization. Extensive integration of tracking and fire-control systems transforms the vessel into a defensive bulwark, but limits the capacity for alternative armament refits.",
    "imperial_executor_ordinance_unit_item_name": "Heavy Ordinance Refit",
    "imperial_executor_ordinance_unit_item_description": "This refit commits the Executor to sustained missile warfare, expanding ordnance capacity and optimizing launch and reload systems for continuous bombardment. The scale of these modifications precludes other combat doctrines, binding the ship to a role centered on overwhelming missile saturation.",
    "imperial_executor_heavy_weapons_unit_item_name": "Linebreaker Refit",
    "imperial_executor_heavy_weapons_unit_item_description": "The Executor is fully committed to direct-fire dominance, with its superstructure and power systems optimized for maximum turbolaser output and accuracy. This specialization sacrifices flexibility in favor of raw destructive capability, preventing the integration of alternate refit doctrines.",
    "imperial_executor_cic_unit_item_name": "Battlegroup Coordination Suite",
    "imperial_executor_cic_unit_item_description": "Command, control, and flight operations are expanded to transform the Executor into a fleet coordination centerpiece. By dedicating internal volume and systems to strikecraft support and battlegroup management, the vessel forgoes other refit paths in favor of strategic force projection.",

