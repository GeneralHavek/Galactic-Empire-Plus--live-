    "imperial_victory1_missile_guidance_coordination_buff_name": "Missile Guidance Coordination",
    "imperial_procursator_dynamic_power_routing_ability_name": "Dynamic Power Routing",
    "imperial_procursator_dynamic_power_routing_ability_description": "Dynamically balances reactor output across combat systems, increasing weapon cooldown reduction, antimatter regeneration, and weapon range for the duration.",
    "imperial_procursator_damage_control_stations_ability_name": "Damage Control Stations",
    "imperial_procursator_damage_control_stations_ability_description": "Mobilizes engineering crews and internal damage-control stations, increasing hull regeneration, shield regeneration, and damage mitigation for the duration.",
    "imperial_procursator_sustained_combat_doctrine_ability_name": "Sustained Combat Doctrine",
    "imperial_procursator_sustained_combat_doctrine_ability_description": "Passively improves long-duration combat performance through increased antimatter regeneration, hull regeneration, and weapon cooldown reduction. Activate to amplify these bonuses for the duration.",
    "imperial_venator_mk2_broadside_coordination_ability_name": "Broadside Coordination",
    "imperial_venator_mk2_broadside_coordination_ability_description": "Synchronizes the Venator Mk II's dorsal and ventral heavy turbolaser batteries, increasing turbolaser range, reducing turbolaser cooldown, and improving turbolaser tracking for the duration.",
    "imperial_venator_mk2_line_battle_doctrine_ability_name": "Line Battle Doctrine",
    "imperial_venator_mk2_line_battle_doctrine_ability_description": "Passively improves turbolaser tracking, strikecraft launch speed, and strikecraft rebuild speed. Activate to improve turbolaser range and cooldown while granting strong shield regeneration, moderate hull regeneration, and light armor regeneration.",
    "imperial_victoryii_electronic_warfare_suite_ability_name": "Electronic Warfare Suite",
    "imperial_victoryii_electronic_warfare_suite_ability_description": "Passively applies stacking Power Disruption when the Victory II damages enemy ships, reducing shield and antimatter regeneration. Activate to additionally apply stacking System Destabilization to disrupted targets, reducing weapon performance and maneuverability.",
    "imperial_victoryii_electronic_warfare_doctrine_ability_name": "Electronic Warfare Doctrine",
    "imperial_victoryii_electronic_warfare_doctrine_ability_description": "Passively improves the Victory II's ion and turbolaser weapon cooldown and tracking. Activate to let allied ships build stacking Target Exploitation bonuses when damaging enemies affected by the Victory II's electronic warfare debuffs.",
    "imperial_victoryii_electronic_warfare_doctrine_active_name": "Electronic Warfare Doctrine",
