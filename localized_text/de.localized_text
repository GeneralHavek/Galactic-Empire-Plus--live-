	"imperial_base_delta_zero_ability_name": "Base Delta Zero",
    "imperial_base_delta_zero_ability_description": "Orbitale Bombardierung, bis jeglicher Widerstand ausgelöscht ist.",
    "imperial_research_lab_structure_phase_lane_detector_ability_name": "ISB Frühwarnprotokolle",
    "imperial_research_lab_structure_phase_lane_detector_ability_description": "Das Imperiale Sicherheitsbüro überwacht Unterlicht- und Hyperraumkommunikation, um nach eingehenden feindlichen Kriegsschiffen zu scannen.",
    "imperial_flak_splash_item_name": "Flakkanonen",
    "imperial_flak_splash_unit_item_description": "Flakkanonen mit explosiven Geschossen, die mit Durastahl-Flechettes gefüllt sind, um Sternjäger und ankommende Raketen mühelos zu durchschlagen.",
    "imperial_pelta_shield_projection_ability_name": "Deflektorschild Projektoranlage",
    "imperial_pelta_shield_projection_ability_description": "Die Pelta verwendet spezialisierte Deflektorschild Arrays, um sowohl die Schilde umliegender Schiffe zu verstärken als auch den eintreffenden Schaden mit ihren eigenen Schilden zu teilen.",
    "imperial_arquitens_command_center_ability_name": "Effiziente Kampf Algorithmen",
    "imperial_arquitens_command_center_ability_description": "Der Arquitens Kommando Kreuzer ist mit speziellen Zielerfassungs Verbindungen ausgestattet. Alle Schiffe in Reichweite bündeln ihre Rechenleistung, um Ziele präziser zu erfassen, während überschüssige ungenutzte Energie in die Antimaterie-Reserven jedes Schiffes zurückgeführt wird.",
    "imperial_strikecraft_ability_dodge_name": "Veteranen Pilotenprogramm",
    "imperial_strikecraft_ability_dodge_description": "Das Imperium hat neue, intensive Pilotentrainingsprogramme eingeführt, um sowohl bestehende als auch neue Piloten besser auf den Einsatz der TIE-Jägerlinie vorzubereiten. Berichte deuten darauf hin, dass ausgebildete Piloten Punktverteidigungsbatterien mit deutlich größerem Erfolg ausweichen können.",
    "imperial_venator_hangar_capacity_ability_name": "Carrier Doctrine",
    "imperial_venator_hangar_capacity_ability_description": "Opens the Venator's full flight deck and expands carrier operations, increasing its ability to launch, replace, and sustain strikecraft squadrons.",

	"imperial_planetary_shield_array_unit_item_name": "SLD-26 Planetarschildgenerator",
	"imperial_planetary_shield_array_unit_item_description": "Überbleibsel imperialer Technologie aus alter Zeit. Mit neuen Materialien dieser Galaxis modernisiert und umgerüstet. Erzeugt einen planetenweiten Deflektorschild.",
	"unit_item_upkeep_reduction_name": "Erweiterte Logistikprotokolle",
	"unit_item_upkeep_reduction_description": "Spezialisierte Protokolle an Bord des Schiffs minimieren Ressourcenschwund und senken die Betriebskosten deutlich.",
    "unit_item_vrip_name": "V-RIP: Venator – Umrüstungsprogramm",
    "unit_item_vrip_desc": "Ein Programm zur Lebensdauerverlängerung, dass die Fähigkeiten der ehrwürdigen Venator-Klasse verbessert. Diese Umrüstung verdoppelt die Hauptbewaffnung mit DBY-827-Turbolasern, fügt Ionenkanonen am Bug hinzu und erhöht die Überlebensfähigkeit des Schiffs.",
	"imperial_starbase_gravity_generator_unit_item_name": "Klasse-B Gravitationsgenerator",
	"imperial_starbase_gravity_generator_unit_item_description": "Durch den Einsatz neuer exotischer Materialien können Schwere-Gravitationswellengeneratoren nun auf Klasse-B Außenposten installiert werden, ohne dass zusätzliche erhebliche Energieverluste entstehen.",
	
	"imperial_specialization_offense_firing_speed_unit_item_name": "Schnellfeuer Zielsysteme",
	"imperial_specialization_offense_firing_speed_unit_item_description": "Ein Algorithmus, der die Feuerrate von Turbolasern und Ionenkanonen erhöht, um schnellere Salven abzufeuern und Ziele schneller zu erfassen, jedoch auf Kosten der Reichweite und Feuerkraft.",
	"imperial_specialization_offense_damage_range_unit_item_name": "Hochleistungs-Zielalgorithmus",
	"imperial_specialization_offense_damage_range_unit_item_description": "Ein Algorithmus, der die Erstschlagfähigkeiten von Turbolasern und Ionenkanonen verbessert, indem die Ladezyklen der Energiewandler verringert werden.",
	"imperial_specialization_offense_exploit_weakness_unit_item_name": "Frequenzmodulations Algorithmus",
	"imperial_specialization_offense_exploit_weakness_unit_item_description": "Ein Algorithmus, der größere Schwankungen in der Frequenz der Turbolaser- und Ionenkanonen-Bolzen ermöglicht, wodurch viele Schüsse die Schilde des Ziels komplett umgehen können. Dies geschieht jedoch auf Kosten der Feuerrate und der allgemeinen Feuerkraft.",
	"imperial_specialization_defense_generator_unit_item_name": "Integritätsmatrix für Deflektorschilde",
	"imperial_specialization_defense_generator_unit_item_description": "Die Deflektorschild Kapazitoren werden kontinuierlich gepuffert, was zu einer erhöhten Schildintegrität führt. Ein Energieschub bringt teilweise ausgefallene Schilde wieder online. Der Schub erfordert eine kurze Verzögerung, während die Kapazitoren Energie umverteilen.",
	"imperial_specialization_defense_hull_and_armor_item_unit_name": "Juggernaut Panzerung",
	"imperial_specialization_defense_hull_and_armor_item_unit_description": "Neue Bedrohungen erfordern zusätzliche Verstärkungen der Überstrukturen imperialer Schiffe.",

	"imperial_defense_culture_research_subject_name": "Militärparaden",
	"imperial_defense_culture_research_subject_name_uppercase": "MILITÄRPARADEN",
	"imperial_defense_culture_research_subject_description": "Regelmäßige, verpflichtende Militärfeiern und Paraden gewährleisten eine maximale Verbreitung der imperialen Botschaften an alle Wesen, ob fremd oder einheimisch.",

	"imperial_deploy_starbase_unit_item_name": "Klasse-B Außenposten errichten",
	"imperial_deploy_starbase_unit_item_description": "Ermöglicht die taktische Stationierung eines Klasse-B Außenpostens in einem neutralen oder umkämpften Gravitationsfeld.",
	"imperial_gas_harvester_unit_item_name": "Schwebende Gasförderkolonie",
    "imperial_gas_harvester_unit_item_description": "Diese schwebenden Städte, ähnlich der Wolkenstadt auf Bespin, fungieren in Wirklichkeit als Raffinerien. Sie filtern die Gase des Planeten und gewinnen nutzbare Materialien für militärische und wirtschaftliche Projekte.",
    "imperial_gas_crystalizer_unit_item_name": "Fortschrittliches Filtrationsdepot",
    "imperial_gas_crystalizer_unit_item_description": "Zusätzliche Filtrationssysteme werden mithilfe fortschrittlicher Konstruktionstechniken installiert, was die langsame Ansammlung spezialisierter exotischer Materialien ermöglicht.",
    "imperial_strip_mining_unit_item_name": "Erzförderer der Minengilde",
    "imperial_strip_mining_unit_item_description": "Das Galaktische Imperium ist bestens darin geübt, planetare Ressourcen mit brutaler Effizienz zu extrahieren. Die Erzförderer der Minengilde sind so modifiziert, dass sie in jeder atmosphärischen Umgebung operieren können.",
    "imperial_command_bunker_unit_item_name": "Imperiales Sturmtruppen Vorpostengarnison",
    "imperial_command_bunker_unit_item_description": "Ein Sturmtruppen Detachment, das entwickelt wurde, um die Verteidigung eines bestimmten Planeten zu verstärken.",
    "imperial_crystal_mines_unit_item_name": "Kristallförderung",
    "imperial_crystal_mines_unit_item_description": "Die Minengilde wurde autorisiert, Kristallerzvorkommen tief in der planetaren Kruste zu erschließen und so die Ausbeutung kristalliner Planeten zu maximieren.",
    "imperial_ferric_mines_unit_item_name": "Metallraffinerie",
    "imperial_ferric_mines_unit_item_description": "Die Minengilde wurde autorisiert, Eisenerzvorkommen tief in der planetaren Kruste zu erschließen und so die Ausbeutung eisenreicher Planeten zu maximieren.",
    "imperial_kessel_mines_unit_item_name": "Kessel Minenverwaltung",
    "imperial_kessel_mines_unit_item_description": "Die Minengilde wurde autorisiert, die Produktion in den Kessel Minen durch effiziente Verwaltungsstrukturen zu maximieren. Umerzogene Arbeitskräfte werden systematisch in die Abläufe integriert.",
    "imperial_homeworld_heart_of_the_galaxy_name": "Herz der Galaxis",
    "imperial_homeworld_heart_of_the_galaxy_description": "Man hat uns aus unserer angestammten Heimat verbannt, doch das Imperium erhebt sich stärker denn je. Unser Vermächtnis ist nicht Schwäche, nicht Mittelmaß, sondern Stärke, Ordnung und Größe. Unter der Führung unseres glorreichen Anführers sichern wir den Wohlstand der Galaxis. Lang lebe das Imperium!",
    "imperial_orbital_targeting_computer_unit_item_name": "Orbital Zielcomputer",
    "imperial_orbital_targeting_computer_unit_item_description": "Spezialisierte Zielsysteme, die mit verbündeten Schiffen vernetzt sind, maximieren die Zerstörungskraft unserer Orbitalschläge. Kein feindlicher Planet ist sicher vor der geballten Macht des Imperiums.",
	"imperial_emperors_will_unit_item_name": "Wille des Imperators",
	"imperial_emperors_will_unit_item_description": "Der Wille des Imperators erstreckt seine Macht selbst auf fernste Welten. Schon die bloße Präsenz der Imperialen Flotte genügt, um ihn Wirklichkeit werden zu lassen.",

