    "imperial_victoryii_target_exploitation_buff_name": "Target Exploitation",
    "imperial_isd1_fleet_coordination_network_ability_name": "Fleet Coordination Network",
    "imperial_isd1_fleet_coordination_network_ability_description": "Coordinates nearby allied ships through the ISD's combat information center, improving turbolaser tracking, ion weapon tracking, target acquisition speed, and sensor range.",
    "imperial_isd1_coordinated_fire_control_ability_name": "Coordinated Fire Control",
    "imperial_isd1_coordinated_fire_control_ability_description": "Coordinates the ISD's heavy turbolaser batteries around a unified firing solution, improving accuracy, reload speed, damage, and target retention for the duration.",
    "imperial_isd1_precision_fire_control_ability_name": "Coordinated Fire Control",
    "imperial_isd1_precision_fire_control_ability_description": "Coordinates the ISD's heavy turbolaser batteries around a unified firing solution, improving accuracy, reload speed, damage, and target retention for the duration.",
    "imperial_isd1_imperial_battle_doctrine_ability_name": "Imperial Battle Doctrine",
    "imperial_isd1_imperial_battle_doctrine_ability_description": "Passively coordinates nearby allied ships, improving antimatter regeneration, shield regeneration, and phase jump charge rate. Activate to expand the command radius and strengthen these bonuses for the duration.",
    "imperial_isd1_imperial_battle_doctrine_passive_aura_name": "Imperial Battle Doctrine",
    "imperial_isd1_imperial_battle_doctrine_active_aura_name": "Imperial Battle Doctrine",
    "imperial_tector_fortified_defense_ability_name": "Fortified Defense",
    "imperial_tector_fortified_defense_ability_description": "Passively gains Battle Hardened stacks when taking damage, improving damage mitigation while shields are active. Activate to greatly increase shield regeneration while also improving hull and armor regeneration.",
    "imperial_tector_assault_barrage_ability_name": "Assault Barrage",
    "imperial_tector_assault_barrage_ability_description": "Coordinates the Tector's heavy turbolaser batteries into a sustained assault barrage, increasing turbolaser range, improving turbolaser tracking, and reducing turbolaser cooldown for the duration.",
    "imperial_tector_linebreaker_doctrine_ability_name": "Linebreaker Doctrine",
    "imperial_tector_linebreaker_doctrine_ability_description": "Enhances the Tector's Battle Hardened defenses and heavy assault capability. Activate to preserve or amplify Battle Hardened benefits while further improving turbolaser range and cooldown reduction.",
    "imperial_tector_battle_hardened_buff_name": "Battle Hardened",
    "imperial_isd2_advanced_fire_control_ability_name": "Advanced Fire Control",
    "imperial_isd2_advanced_fire_control_ability_description": "Uses upgraded fire-control computers to optimize turbolaser and ion cannon performance, improving weapon tracking and reducing weapon cooldown for the duration.",
    "imperial_isd2_concentrated_fire_doctrine_ability_name": "Concentrated Fire Doctrine",
    "imperial_isd2_concentrated_fire_doctrine_ability_description": "Designates a priority target and coordinates the ISD II's heavy batteries against it, increasing weapon damage, tracking, and cooldown reduction against that target only.",
    "imperial_isd2_concentrated_fire_doctrine_on_target_name": "Concentrated Fire Doctrine",
    "imperial_isd2_tarkin_doctrine_ability_name": "Tarkin Doctrine",
    "imperial_isd2_tarkin_doctrine_ability_description": "Passively gains permanent Imperial Ascendancy stacks whenever qualifying enemy ships or starbases are destroyed in the same gravity well. Activate to temporarily amplify the ISD II's combat bonuses.",
    "imperial_isd2_imperial_ascendancy_name": "Imperial Ascendancy",
    "imperial_isd2_tarkin_doctrine_active_name": "Tarkin Doctrine",    
    "imperial_allegiance_imperial_bulwark_ability_name": "Imperial Bulwark",
    "imperial_allegiance_imperial_bulwark_ability_description": "Passively improves shield regeneration, armor, and hull regeneration. Activate to greatly increase defensive regeneration and apply Oppressive Intent to all enemy ships in the gravity well, reducing their weapon range, tracking, and rate of fire.",
    "imperial_allegiance_imperial_bulwark_oppressive_intent_name": "Oppressive Intent",
    "imperial_allegiance_hullbreaker_doctrine_ability_name": "Hullbreaker Doctrine",
    "imperial_allegiance_hullbreaker_doctrine_ability_description": "Applies stacking Structural Failure when the Allegiance damages enemy ships, increasing the damage those targets receive from all sources. Activate to further exploit targets affected by Structural Failure.",
    "imperial_allegiance_hullbreaker_doctrine_structural_failure_name": "Structural Failure",
    "imperial_allegiance_hullbreaker_doctrine_active_exploit_name": "Hullbreaker Exploitation",
    "imperial_allegiance_annihilation_protocol_ability_name": "Annihilation Protocol",
    "imperial_allegiance_annihilation_protocol_ability_description": "Passively improves weapon range, tracking, cooldown reduction, and damage. Activate to apply stacking Execution Mandate to every enemy damaged by the Allegiance, increasing damage received from all allied sources.",
    "imperial_allegiance_annihilation_protocol_execution_mandate_name": "Execution Mandate",
    "imperial_executor_imperial_resolve_ability_name": "Imperial Resolve",
    "imperial_executor_imperial_resolve_ability_description": "Passively inspires allied ships within the gravity well, increasing weapon cooldown reduction, antimatter regeneration, shield regeneration, and hull regeneration. Activate to significantly amplify these bonuses for the duration.",
    "imperial_executor_imperial_resolve_passive_aura_name": "Imperial Resolve",
    "imperial_executor_imperial_resolve_active_aura_name": "Imperial Resolve",
    "imperial_executor_sector_command_ability_name": "Sector Command",
    "imperial_executor_sector_command_ability_description": "Asserts operational control over the gravity well. Allied ships gain weapon cooldown reduction, weapon tracking, movement speed, and turn rate, while enemy ships suffer reduced antimatter regeneration, movement speed, and turn rate.",
    "imperial_executor_sector_command_allied_aura_name": "Sector Command",
    "imperial_executor_sector_command_enemy_debuff_name": "Sector Command",
    "imperial_executor_imperial_hegemony_ability_name": "Imperial Hegemony",
    "imperial_executor_imperial_hegemony_ability_description": "Passively improves allied fleet weapon cooldown reduction, shield regeneration, antimatter regeneration, and hull regeneration within the gravity well. Activate to greatly increase allied combat efficiency while reducing enemy weapon performance and maneuverability.",
    "imperial_executor_imperial_hegemony_enemy_debuff_name": "Imperial Hegemony",
    "imperial_executor_operational_logistics_ability_name": "Operational Logistics",
    "imperial_executor_assault_operations_ability_name": "Assault Operations",
    "imperial_executor_strategic_operations_ability_name": "Strategic Operations",
    "imperial_executor_strategic_operations_enemy_debuff_name": "Strategic Operations",
    "imperial_executor_operational_logistics_unit_item_name": "Operational Logistics",
    "imperial_executor_operational_logistics_unit_item_description": "Configures the Executor as the logistical center of the Imperial war machine, increasing antimatter regeneration, shield regeneration, hull regeneration, and phase jump charge rate. Replaces Imperial Hegemony with Operational Logistics.",
    "imperial_executor_assault_operations_unit_item_name": "Assault Operations",
    "imperial_executor_assault_operations_unit_item_description": "Configures the Executor for maximum offensive fleet operations, improving turbolaser, ion, concussion missile, and proton torpedo weapon damage, range, tracking, and cooldown reduction. Replaces Imperial Hegemony with Assault Operations.",
    "imperial_executor_strategic_operations_unit_item_name": "Strategic Operations",
    "imperial_executor_strategic_operations_unit_item_description": "Configures the Executor for long-duration command and battlefield control, increasing antimatter capacity, antimatter regeneration, maximum hull, and maximum shields. Replaces Imperial Hegemony with Strategic Operations.",
    "imperial_death_star_operations_ability_name": "Operational Readiness",
    "imperial_death_star_operations_ability_description": "The Death Star's operational configuration changes according to the installed command package. Without a configuration item, Operational Readiness improves shield regeneration, hull regeneration, antimatter regeneration, weapon cooldown reduction, and weapon tracking.",
    "imperial_death_star_damage_control_readiness_buff_name": "Damage Control Readiness",
    "imperial_death_star_target_saturation_buff_name": "Target Saturation",
    "imperial_death_star_operational_readiness_ability_name": "Operational Readiness",
    "imperial_death_star_battlestation_alert_ability_name": "Battlestation Alert",
    "imperial_death_star_total_fire_control_ability_name": "Total Fire Control",
    "imperial_death_star_doctrine_of_fear_ability_name": "Doctrine of Fear",
    "imperial_death_star_battlestation_operations_ability_name": "Battlestation Operations",
    "imperial_death_star_weapons_operations_ability_name": "Weapons Operations",
    "imperial_death_star_peacekeeping_operations_ability_name": "Peacekeeping Operations",
    "imperial_death_star_coercive_presence_ability_name": "Coercive Presence",
    "imperial_death_star_coercive_presence_active_ability_name": "Coercive Presence",
    "imperial_death_star_systemic_terror_ability_name": "Systemic Terror",    
    "imperial_death_star_battlestation_operations_unit_item_name": "Battlestation Operations",
    "imperial_death_star_battlestation_operations_unit_item_description": "Configures the Death Star for maximum defensive capability, increasing maximum hull, maximum shields, armor, hull regeneration, and shield regeneration. Replaces Operational Readiness with Battlestation Alert.",
    "imperial_death_star_weapons_operations_unit_item_name": "Weapons Operations",
    "imperial_death_star_weapons_operations_unit_item_description": "Configures the Death Star's conventional weapons for maximum fleet-combat performance, improving turbolaser, ion, and concussion weapon range, tracking, cooldown reduction, and damage. Replaces Operational Readiness with Total Fire Control.",
    "imperial_death_star_peacekeeping_operations_unit_item_name": "Peacekeeping Operations",
    "imperial_death_star_peacekeeping_operations_unit_item_description": "Configures the Death Star for strategic deployment, planetary subjugation, and the maintenance of Imperial order, increasing antimatter capacity, antimatter regeneration, movement speed, turn rate, and phase jump charge rate. Replaces Operational Readiness with Doctrine of Fear.",
    "imperial_death_star_battlestation_operations_mutation_name": "Battlestation Operations",
    "imperial_death_star_weapons_operations_mutation_name": "Weapons Operations",
    "imperial_death_star_peacekeeping_operations_mutation_name": "Peacekeeping Operations",
    "imperial_death_star_faction_victory_unit_item_description": "The Emperor himself sits upon his throne within the battlestation's command center. All will bow before the power of this fully armed and operational battlestation.",


    "imperial_dreadnought_name": "Dreadnought Schwerer Kreuzer",
    "imperial_dreadnought_name.garrison": "Dreadnought der Garnison",
    "imperial_dreadnought_description": "Die Dreadnought ist ein äußerst langsames Schiff, das immense Treffer einstecken kann, bevor es zerstört wird. Dank der Slave Rigging-Technologie performen diese Schiffe besonders gut, wenn sie in Gruppen von fünf eingesetzt werden.",
    "imperial_tonfalk_name": "Ton-Falk Eskortträger",
    "imperial_tonfalk_name.garrison": "Ton-Falk der Garnison",
    "imperial_tonfalk_description": "Die Eskortträger der Ton-Falk Klasse ist ein Schiff, das mehrere Sternjäger-Squadronen beherbergt, wodurch es Flotten zusätzliche Sternjäger-Unterstützung bietet, wenn nötig.",
    "imperial_venator_name": "Venator der Klonkriegszeit",
	"imperial_venator_loot_name": "Venator Trümmer",
    "imperial_venator_description": "Der Venator Sternzerstörer wurde von der Republik als Trägerschiff für Klon Truppen und Sternjägerflotten konzipiert. Seine außergewöhnliche Geschwindigkeit und die großen Hangarkapazitäten machten ihn zum Rückgrat der republikanischen Flotte während der Klonkriege. Allerdings führte der Fokus auf Mobilität und Sternjägerunterstützung dazu, dass seine direkte Feuerkraft im Vergleich zu seiner Größe begrenzt war.",
    "rep_venator_name": "Imperialisierte Venator Mk.2",
	"rep_venator_loot_name": "Venator Trümmer",
    "rep_venator_description": "Die imperialisierte Version des Venator wurde an die Anforderungen des Galaktischen Imperiums angepasst. Während seine Rolle als Trägerschiff für Sternjägerflotten und Truppentransporte erhalten blieb, wurden seine Bewaffnung und Schilde leicht verstärkt, um in größeren Flottenoperationen bestehen zu können. Dennoch bleibt seine Feuerkraft hinter moderneren imperialen Designs wie der Imperial Klasse zurück.",
    "imperial_mtc_name": "Reparaturkreuzer",
    "imperial_mtc_name.garrison": "Reparaturkreuzer der Garnison",
    "imperial_mtc_description": "Dieser Kreuzer ist speziell auf Reparaturaufgaben innerhalb einer Taskforce ausgerichtet und sorgt dafür, dass beschädigte Schiffe schnell wieder einsatzfähig sind.",
    "imperial_acclamator_name": "Acclamator Angriffstransporter",
    "imperial_acclamator_description": "Der Acclamator Angriffstransporter ist primär auf planetare Landungen ausgerichtet, aber seine leichte Bewaffnung ermöglicht es ihm, kleinere Schiffe zu bekämpfen.",
	"imperial_acclamator_2_name": "Acclamator II Angriffsschiff",
    "imperial_acclamator_2_description": "Die Acclamator II bietet eine erhöhte Geschwindigkeit und Manövrierfähigkeit im Vergleich zu ihrem Vorgänger. Zusätzlich wurde sie mit mittleren Turbolasern ausgestattet, während andere Waffensysteme reduziert wurden, um ihre Rolle als imperialer Frontkreuzer zu festigen.",	
	"imperial_indictor_name": "Indictor Korvette",
    "imperial_indictor_description": "Diese Korvette ist eine hochmobile Aufklärungseinheit, die speziell für das Erforschen und Überwachen von feindlichen Bewegungen entwickelt wurde. Sie ist unbewaffnet und verlässt sich auf ihre Schnelligkeit, um Gefahren zu entkommen",
    "imperial_arquitens_name": "Arquitens Leichter Kreuzer",
    "imperial_arquitens_name.garrison": "Arquitens der Garnison",
    "imperial_arquitens_description": "Dieser Kreuzer wird zur Verstärkung von Flotten eingesetzt und liefert zusätzliche, leicht austauschbare Feuerkraft.",
	"imperial_arquitens_command_name": "Arquitens Kommandokreuzer",
    "imperial_arquitens_command_description": "Neue Sensorarrays und Kommunikationssysteme wurden in der wendigen Fregatte installiert, um die Zielgenauigkeit und Reaktionszeit zu verbessern.",
	"imperial_vigil_name": "Vigil Korvette",
    "imperial_vigil_name.garrison": "Vigil der Garnison",
    "imperial_vigil_description": "Diese Korvette ist für defensive Operationen ausgelegt. Es wurde als Vorposten- und Aufklärungsschiff sowie als Eskortschiff für Kreuzer entwickelt.",
    "imperial_cr90_name": "CR-90 Korvette",
    "imperial_cr90_name.garrison": "CR-90 der Garnison",
    "imperial_cr90_description": "Die CR-90 ist eine schnelle, vielseitige Korvette, die sowohl in der Aufklärung als auch in der Unterstützung größerer Schlachtschiffe eingesetzt wird.",
	"imperial_cr90_trade_ship_name": "CR-90 Eskort Korvette",
    "imperial_cr90_trade_ship_description": "Eine ältere, aber äußerst wendige zivile Korvette, die für ihre Größe moderat bewaffnet war. Eingesetzt zur Unterstützung des militärisch-industriellen Komplexes des Imperiums.",
    "imperial_vindicator_name": "Vindicator Schwerer Kreuzer",
    "imperial_vindicator_name.garrison": "Vindicator der Garnison",
    "imperial_vindicator_description": "Die Vindicator ist ein Kreuzer, der wenig Feuerkraft, aber hervorragende Panzerung und Schilde aufweist und als Träger fungieren kann.",
    "imperial_victoryii_name": "Victory II Sternzerstörer",
	"imperial_victoryii_loot_name": "Victory II Trümmer",
    "imperial_victoryii_name.garrison": "Victory II der Garnison",
    "imperial_victoryii_description": "Der Victory II Sternzerstörer ist ein schnell beweglicher, mäßig bewaffneter Zerstörer, der dazu in der Lage ist, Feindschiffe zu verfolgen und auszumanövrieren. Er ist außerdem deutlich günstiger als die größeren Imperial-Klasse Sternzerstörer.",
	"imperial_victoryi_name": "Victory I Sternzerstörer",
    "imperial_victoryi_name.garrison": "Victory I der Garnison",
    "imperial_victoryi_description": "Der Victory I Sternzerstörer ist eines der schwer bewaffneten Schiffsklassen der Republikflotte, ausgestattet mit schweren Raketenwaffen und Turbolasern. Er ist darauf ausgelegt, 1-2 hochpriorisierte Ziele zu fokussieren. Allerdings ist er extrem langsam.",
    "imperial_victoryi_loot_name": "Victory I Trümmer",
	"imperial_isd1_name": "Imperial I Sternzerstörer",
	"imperial_isd1_loot_name": "ISD 1 Trümmer",
    "imperial_isd1_description": "Der Imperial I Sternzerstörer ist ein schwer bewaffnetes Kriegsschiff, das entwickelt wurde, um mehrere Schiffe gleichzeitig zu bekämpfen und große Flottengefechte zu überstehen.",
    "imperial_tector_name": "Tector Sternzerstörer",
	"imperial_tector_loot_name": "Tector Trümmer",
    "imperial_tector_description": "Der Sternzerstörer der Tector Klasse wurde entwickelt, um gemeinsam mit anderen Schiffen zu operieren, da er kein Sternjägerkontingent besitzt. Stattdessen ist er auf den Einsatz überwältigender Feuerkraft spezialisiert.",
    "imperial_isd2_name": "Imperial II Sternzerstörer",
	"imperial_isd2_loot_name": "ISD 2 Trümmer",
    "imperial_isd2_description": "Der Imperial II Klasse Sternzerstörer ist eine verbesserte Version des ISD-I und erfüllt eine ähnliche Rolle in der Imperialen Flotte.",
    "imperial_lancer_name": "Lancer Fregatte",
    "imperial_lancer_name.garrison": "Lancer der Garnison",
    "imperial_lancer_description": "Lancer sind speziell darauf ausgelegt, Sternjäger zu bekämpfen und gehören zu den besten Antisternjäger-Schiffen der Galaxis.",
    "imperial_velox_name": "Velox Fregatte",
    "imperial_velox_name.garrison": "Velox der Garnison",
    "imperial_velox_description": "Die Velox ist eine schnelle und wendige Fregatte, die für den Einsatz in speziellen, blitzschnellen Angriffen gegen kleinere Schiffe konzipiert wurde.",
    "imperial_tie_fighter_name": "TIE-Jäger",
    "imperial_tie_fighter_description": "TIE/ln Jäger sind billig in der Herstellung und äußerst effektiv in großen Zahlen.",
    "imperial_tie_interceptor_name": "TIE-Interceptor",
    "imperial_tie_interceptor_description": "TIE/in Interceptoren sind nützlich im Kampf gegen Bomber und sind sehr schnell.",
    "imperial_tie_defender_name": "TIE-Verteidiger",
    "imperial_tie_defender_description": "TIE/D Jäger sind fortschrittlich und äußerst effektive Raumüberlegenheitsjäger.",
    "imperial_tie_bomber_name": "TIE-Bomber",
    "imperial_tie_bomber_description": "TIE/sa Bomber sind auf den Angriff auf Einrichtungen und große Sternenschiffe spezialisiert.",
    "imperial_tr_galleon_name": "Galleon",
    "imperial_tr_galleon_description": "Dieses Schiff ist eine schwer bewaffnete Handelsplattform und wird von Piraten als Kampfkreuzer genutzt.",
    "imperial_procursator_name": "Procursator Sternzerstörer",
	"imperial_procursator_loot_name": "Procursator Trümmer",
    "imperial_procursator_description": "Die Procursator Klasse wurde von Kuat Drive Yards als frühes Kriegsschiff entwickelt und fand sowohl in der Galaktischen Republik während der Klonkriege als auch später im Imperium Verwendung. Sie diente hauptsächlich als Feuerunterstützungs- und Eskortschiff, wobei sie als Übergangsmodell zwischen der Victory-Klasse und der Venator-Klasse galt.",
    "imperial_allegiance_name": "Allegiance Supersternzerstörer ",
	"imperial_allegiance_loot_name": "Allegiance Trümmer",
    "imperial_allegiance_description": "Die Allegiance Supersternzerstörer sind imposante Kriegsschiffe mit einer Vielzahl leistungsstarker Waffensysteme, die auf den direkten Schiffskampf ausgelegt sind. Bis zu 4 dieser Schiffe können gleichzeitig stationiert werden.",
    "imperial_immobilizer_name": "Immobilizer 418 Abfangkreuzer",
	"imperial_immobilizer_description": "Auch bekannt als die Interdictor Klasse, dieses Schiff wird eingesetzt, um feindliche Schiffe daran zu hindern, in den Hyperraum zu fliehen. Es besitzt auch leichte Bewaffnung für begrenzte Anti-Sternjäger und Anti-Korvette Operationen.",
    "imperial_interdictor_name": "Interdictor Sternzerstörer",
    "imperial_interdictor_description": "Dieser Sternzerstörer wurde entwickelt, um Interdictor Felder zu erzeugen, die es ermöglichen, feindliche Schiffe zu stoppen und in normales Raumflugtempo zurückzuzwingen.",
    "imperial_gunpod_name": "Turbolaser Turm",
    "imperial_gunpod_description": "Ein statisches Waffensystem, das für die Verteidigung von Stationen und größeren Schiffen verwendet wird.",
    "imperial_starbase_name": "Klasse-B Militärischer Außenposten",
	"imperial_starbase_loot_name": "Klasse-B Trümmer",
    "imperial_starbase_description": "Ein militärischer Außenposten, der als Versorgungsstation und Reparaturbasis für die Imperialen Flotten dient.",

    "pirate_lucrehulk_name": "Lucrehulk Schlachtschiff",
	"pirate_lucrehulk_loot_name": "Lucrehulk Trümmer",
    "pirate_lucrehulk_description": "Dieses umgebaute Frachtschiff ist voller Waffensysteme und stellt das stärkste Großkampfschiff im Arsenal der KUS dar. Es verfügt über ein beeindruckendes Kontingent an Droiden-Sternjägern, die mit Discord-Raketen ausgestattet sind.",
    "pirate_munificent_name": "Munificent Fregatte",
    "pirate_munificent_description": "Die Munificent Klasse wird für Kommunikation und elektronische Kriegsführung eingesetzt und besitzen eine massive Turbolaser-Kanone im Bug sowie doppelte Ionenkannonen, die gegen einzelne Ziele, selbst größere Schiffe, äußerst effektiv sind.",
    "pirate_xx777_name": "XX-777 Korvette",
    "pirate_xx777_description": "Die XX-777 Korvette ist ein wendiges Piratenschiff, das für schnelle Angriffe und Überfälle auf Handelsrouten genutzt wird. Sie ist eine tödliche Bedrohung für kleinere Schiffe und Versorgungsflotten. Ursprünglich für militärische Zwecke gebaut, wurde sie von Piraten übernommen, die ihre hohe Wendigkeit und schnelle Einsatzfähigkeit für Guerillakriegsführung im offenen Raum nutzen.",
    "pirate_kihraxz_name": "Kihraxz Interceptor",
    "pirate_kihraxz_description": "Dieser schnelle und tödliche Interceptor wird in den Piraten Flotten verwendet, um gegnerische Bomber zu eliminieren.",
	"pirate_t62_name": "T62 Convor",
    "pirate_t62_description": "Der direkte Vorläufer des T65 X-Wing von Incom. Er verfügt über verbesserte Triebwerke und Schilde im Vergleich zum Z-95 Headhunter sowie eine Ansammlung von Raketengeschützen an jedem Flügel, die seine Tödlichkeit gegen stark gepanzerte Ziele erhöhen.",
	"pirate_aggressor_name": "Aggressor Zerstörer",
	"pirate_aggressor_loot_name": "Aggressor Wrack",
	"pirate_aggressor_description": "Die Antwort der Unterwelt auf den imperialen Sternenzerstörer. Zwei mächtige dorsale Plasmaturbokanonen für verheerende Eröffnungsfeuer. Hangarvolumen geopfert für mehr Turbolaser. Vier Doppelläufige Massentreiber Geschütz ergänzen die Großkampfschiff-Feuerkraft.",
	"pirate_vengeance_name": "Vengeance Fregatte",
	"pirate_vengeance_description": "Nur dem Namen nach Fregatte. Zwei gatlingartige Doppelmassbeschleuniger zerreißen Schilde und Rümpfe in kürzester Zeit.",
	"pirate_ysalamiri_name": "Ysalamiri Kreuzer",
	"pirate_ysalamiri_description": "Älteres Mando Motors Design mit beeindruckender Feuerkraft. Starke Schilde und zahlreiche Waffensysteme besiegen größere, modernere Schiffe.",
	"pirate_rill_name": "Rill Korvette",
	"pirate_rill_name.garrison": "Rill der Garnision",
	"pirate_rill_description": "Mandal Motors baute die Rill Korvette als Inbegriff von Aufklärung und überlegene Feuerkraft ihrer Klasse.",
	"pirate_keldabe_name": "Keldabe Schlachtschiff",
	"pirate_keldabe_loot_name": "Keldabe Wrack",
	"pirate_keldabe_description": "Hybrides Angriffsschiff mit begrenzter Trägerunterstützung. Design priorisiert anhaltenden Druck und Gefechtsausdauer durch geschichtete Feuerkraft.",
	"pirate_mining_frigate_name": "HJ-45 Bergbau Fregatte",
	"pirate_mining_frigate_name.garrison": "HJ-45 der Garnision",
	"pirate_mining_frigate_description": "Umgerüstetes Bergbauschiff mit robuster Konstruktion. Rückgrat von Verteidigungsflotten durch günstigen Preis und halbmodularen Aufbau.",
    "pirate_bulwark_name": "Bulwark-Class Support Frigate",
    "pirate_bulwark_description": "Originally produced by SoroSuub Corporation as a modular convoy support platform, the Bulwark-class was rapidly adopted and modified by independent trade coalitions and syndicate fleets.",
    "pirate_deuteros_name": "Deuteros-class Cruiser",
    "pirate_deuteros_description": "Commissioned by Pantora to protect distant commercial interests, the Deuteros-class Cruiser combines exceptional firepower with long-range endurance. Surplus vessels have since found new life among independent traders and syndicate fleets seeking a warship capable of defending valuable cargo and projecting authority across contested space.",
    "pirate_rupture_name": "Rupture-class Support Cruiser",
    "pirate_rupture_description": "Originally developed with assistance from SoroSuub Corporation for long-range convoy support, the Rupture-class combines fleet coordination systems, disabling ion weaponry, and robust defensive armament. Its versatility and reliability have made it a favored support vessel among independent traders and syndicate fleets operating far from established authority.",

    "imperial_golan1_name": "Golan-1 Verteidigungsplattform",
	"imperial_golan1_description": "Die Golan-1-Verteidigungsplattform wurde von der imperialen Flotte entwickelt, um als erste Linie orbitaler Verteidigung zu dienen. Ausgestattet mit einer Feuerkraft, die einem Sternenzerstörer gleicht, und einem Hangar für Abfangjäger und Bomber ist sie ideal, um feindliche Angriffe abzuwehren und strategische Positionen zu sichern.",
    "imperial_kontos_name": "Kontos Fregatte",
    "imperial_kontos_name.garrison": "Kontos der Garnison",
    "imperial_kontos_description": "Die Kontos Fregatte ist eine kleine, aber mächtige Ergänzung der imperialen Flotte. Sie verfügt über starke Turbolaser für größere Ziele und Lasergeschütze für kleinere, wendigere Ziele.",
    "imperial_gladiator_name": "Gladiator Sternzerstörer",
    "imperial_gladiator_description": "Die nächste Entwicklungsstufe im imperialen Trägerdesign: Der Gladiator ist der Nachfolger des Venator. Obwohl als Kreuzer klassifiziert, verfügt er über einen großzügigen Hangar und kann es mit Schiffen der Kapital-Klasse aufnehmen.",
    "imperial_pelta_name": "Pelta Fregatte",
    "imperial_pelta_name.garrison": "Pelta der Garnison",
    "imperial_pelta_description": "Die Pelta Fregatte war das vielseitige Arbeitstier der Flotte der Alten Republik und für viele Rollen geeignet. Sie wurde nun umgerüstet, um der imperialen Flotte dringend benötigte Unterstützung und Jägerabwehr zu bieten. Sie ist außerdem effektiv gegen kleinere Kreuzer und Fregatten.",
	"imperial_culture_center_structure_name": "Holonet Array",
	"imperial_culture_center_structure_description": "Orbitale Plattform zur Förderung imperialer Gesinnung und Unterdrückung von Fehlinformationen.",

	"imperial_shipyard_name": "Orbitalwerft",
	"imperial_shipyard_description": "Ermöglicht den Bau von Korvetten, Fregatten und Kreuzern.",
	"imperial_heavy_shipyard_name": "Schwere Orbitalwerft",
	"imperial_heavy_shipyard_description": "Ermöglicht den Bau von Großkampfschiffen.",
	"imperial_death_star_name": "DS-1 Orbitalkampfstation",
	"imperial_death_star_loot_name": "DS-1 Orbitalkampfstation Wrack",
	"imperial_death_star_description": "Die DS-1, auch Todesstern genannt, ist der Höhepunkt imperialer Kampfstationtechnologie. Ihre Feuerkraft entspricht einer ganzen Flotte und ihr Superlaser der Mark I kann ganze Planeten vernichten. Da in dieser neuen Galaxis keine Kyberkristalle existieren, wurde das Fokussystem des Superlasers auf neuartige, äußerst potente exotische Materialien umgestellt.",
	"imperial_executor_name": "Executor Super Sternenzerstörer",
	"imperial_executor_loot_name": "Executor Super Sternenzerstörer Wrack",
	"imperial_executor_description": "Höhepunkt imperialer Flottenmacht. Der Executor Super Sternenzerstörer zerstört Gegner mit eiserner Faust und steigert die Kampfkraft umliegender imperialer Schiffe als mobiles Flottenkommando.",
	"imperial_executor_pd_unit_item_name": "Aegis Punktverteidigung",
	"imperial_executor_pd_unit_item_description": "Der Executor wird für umfassende Nahverteidigung umgerüstet. Geschichtete Punktverteidigung priorisiert defensive Doktrinen. Erweiterte Zielverfolgungssysteme machen ihn zur uneinnehmbaren Festung, andere Aufrüstungen sind ausgeschlossen.",
	"imperial_executor_ordinance_unit_item_name": "Schwere Lenkwaffen Nachrüstung",
	"imperial_executor_ordinance_unit_item_description": "Der Executor wird für anhaltende Lenkwaffen-Beschuss optimiert. Erhöhte Munitionskapazität und optimierte Abschuss-/Nachladezyklen für kontinuierliche Salven. Exklusiv für Raketendoktrin ausgelegt.",
	"imperial_executor_heavy_weapons_unit_item_name": "Linienbrecher Nachrüstung",
	"imperial_executor_heavy_weapons_unit_item_description": "Der Executor wurde für direkte Feuerüberlegenheit optimiert. Überstruktur und Energiesysteme maximieren die Turbolaserleistung und Präzision.",
	"imperial_executor_cic_unit_item_name": "Kampfgruppen Kommandosuite",
	"imperial_executor_cic_unit_item_description": "Kommando-, Kontroll- und Flugoperationen erweitert. Executor wird zum Flottenzentrum für Strikecraft und Kampfgruppensteuerung. Strategische Kraftprojektion statt alternativer Aufrüstungspfade.",

	"imperial_assault_concussion_missile_name": "Angriffs Erschütterungsraketen",
	"imperial_assault_concussion_missile_description": "Große und langsame konventionelle Sprengköpfe.",
	"imperial_concussion_missile_name": "Erschütterungsraketen",
	"imperial_concussion_missile_description": "Kleine und schnelle konventionelle Sprengköpfe.",
	"imperial_proton_torpedo_name": "Protonentorpedo",
	"imperial_proton_torpedo_description": "Mittlerer und langsamer Energiesprengkopf.",

	"player_ai_imp_taunt.1": "Erblickt die Macht des Zorns des Imperators. Kniet nieder oder werdet in die Hüllenplatten meines Sternenzerstörers geschliffen.",
	"player_ai_imp_taunt.2": "Ihr badet in der Illusion des Widerstands. Ich werde eure letzte Übertragung zu einer Warnung machen, die durch die Galaxis hallt. Euer Schweigen wird euer Grabstein sein.",
	"player_ai_imp_taunt.3": "Ihr nennt euch Herren eures eigenen Willens. Ich nenne euch Ziele. Bereitet euch darauf vor, von den Sternenkarten getilgt zu werden.",
	"player_ai_imp_taunt.4": "Eure zerlumpten Flotten sind nichts als Brennstoff für das Feuer des Imperiums. Brennt, kleine Funken.",
	"player_ai_imp_taunt.5": "Darth Vaders Schatten fällt bereits über euch. Lauft, wenn ihr wollt – ihr werdet nur müde sterben.",
	"player_ai_imp_taunt.6": "Ergebt euch jetzt, und ihr mögt mit einem Rest Würde sterben. Leistet Widerstand, und euer Ende wird zum Exempel.",
	"player_ai_imp_taunt.7": "Wir beanspruchen diesen Sektor im Namen des Imperators Palpatine. Eure Rebellion wird eine Fußnote der imperialen Geschichte sein – eine kurze und beschämende.",
	"player_ai_imp_taunt.8": "Dies ist keine Verhandlung, es ist Auslöschung. Wir bringen Frieden und ihr nur das Echo eurer eigenen Niederlage.",
	"player_ai_imp_taunt.9": "Erblickt den Keil meines Sternenzerstörers. Diese Silhouette ist das Urteil des Imperators. Wenn unsere Turbolaser Batterien feuern, werden eure Schilde brechen, eure Zufluchten brennen und eure Rebellion aus jedem Sternenregister getilgt sein.",
	"player_ai_imp_taunt.10": "In jedem System, das ihr verseucht, unter jedem Felsen, unter dem ihr euch verkriecht, wird euch das Imperium finden. Wir werden eure Welten versengen, eure Flotten zerschmettern und nur Rauschen hinterlassen, wo einst euer Aufschrei erklang.",

	"player_ai_imp_alliance.1": "Auf Erlass des Imperators wird dieses Bündnis geschmiedet – nicht aus Vertrauen, sondern aus Notwendigkeit. Wenn unser Ziel erreicht ist, werdet ihr knien.",
	"player_ai_imp_alliance.2": "Wenn Lord Vader Einheit befiehlt, sollt ihr Einheit haben – bis der letzte Rebell gefallen ist. Betet danach, dass das Imperium euren Namen vergisst.",
	"player_ai_imp_alliance.3": "Die Vision des Imperators übersteigt meine eigene Ambition. Ich dulde dieses Bündnis… vorerst. Doch wenn sein Wille vollendet ist, wird allein das Imperium bestehen.",

	"player_ai_imp_bounty_taunt.0": "Auf Erlass des Oberkommandos des Imperiums wurde ein Kopfgeld auf {} ausgesetzt. Mögen die Gesetzlosen dieses Sektors sich mit eurer Korrektur befassen.",
	"player_ai_imp_bounty_taunt.1": "Das Imperium hat Mittel bereitgestellt, um... unabhängige Aggression gegen {} zu fördern. Eure Stabilität liegt nicht länger in unserem Interesse.",
	"player_ai_imp_bounty_taunt.2": "{} gefährdet die Ordnung des Imperiums. Lokale Plünderer wurden entsprechend motiviert.",
	"player_ai_imp_bounty_taunt.3": "Ich habe euer Scheitern vorausgesehen, {}. Die Unterwelt vollzieht nur, was das Schicksal bereits bestimmt hat. — Imperator Palpatine",
	"player_ai_imp_bounty_taunt.4": "Ihr verwechselt Nachsicht mit Schwäche, {}. Sehen wir, wie ihr euch schlagt, wenn das Chaos seinen Blick auf euch richtet. — Imperator Palpatine",
	"player_ai_imp_bounty_taunt.5": "Unordnung ist ein nützliches Werkzeug. Heute wird {} lernen, wie nützlich. — Imperator Palpatine",
	"player_ai_imp_bounty_taunt.6": "{} wird nun die Folgen imperialer Aufmerksamkeit erfahren. — Lord Vader",
	"player_ai_imp_bounty_taunt.7": "Eure Verteidigungen werden geprüft, {}. Der Ehrgeiz der Söldner wurde in eure Richtung kanalisiert. — Lord Vader",
	"player_ai_imp_bounty_taunt.8": "Rache ist bedeutungslos, {}. Nur Effizienz bleibt. — Lord Vader",
	"player_ai_imp_bounty_taunt.9": "Strategische Mittel wurden umgeleitet. Plünderer wurden angewiesen, sich vorrangig um {} zu kümmern.",
	"player_ai_imp_bounty_taunt.10": "Jedes Imperium hält sich für sicher, {}. Sehen wir, wie lange diese Illusion ungehindertem Raub standhält. — Imperator Palpatine",

