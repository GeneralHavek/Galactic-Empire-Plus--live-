    "imperial_power_weapons_ability_name": "Divert Power to Weapons",
    "imperial_power_weapons_ability_description": "Re-rout power from the shields to cycle weapons faster.",
    "imperial_jump_disruption_ability_name": "Gravity Well Generator",
    "imperial_jump_disruption_ability_description": "Interferes with the hyperdrives of enemy ships within the area, preventing them from jumping away.",
    "ability_ion_blast_name": "Ion Blast",
    "ability_ion_blast_desc": "A concentrated, high intensity ion shot that will disable an enemy vessel for a time.",
    "imperial_base_delta_zero_ability_name": "Base Delta Zero",
    "imperial_base_delta_zero_ability_description": "Orbital Bombardment until all resistance is obliterated.",
    "imperial_research_lab_structure_phase_lane_detector_ability_name": "ISB Early Warning Protocols",
    "imperial_research_lab_structure_phase_lane_detector_ability_description": "The Imperial Security Bureau monitors sublight and hyperspace communications to scan for incoming hostile warships.",
    "imperial_flak_splash_item_name": "Flak Cannons",
    "imperial_flak_splash_unit_item_description": "Flak cannons with explosive shells packed with durasteel flechettes to tear through starfighters and incoming missiles with ease.",
    "imperial_pelta_shield_projection_ability_name": "Deflector Shield Projector Array",
    "imperial_pelta_shield_projection_ability_description": "The Pelta uses specialized deflector arrays to both strengthen the shielding of ships around it as well as splitting incoming damage with its own deflector shields.",
    "imperial_arquitens_command_center_ability_name": "Efficient Combat Algorithms",
    "imperial_arquitens_command_center_ability_description": "The Arquitens Command Cruiser is outfitted with specialized targeting uplinks. All ships within range pool their processing power to more effectively place shots on target while also returning excess unused power to the antimatter reserves of each ship.",
    "imperial_strikecraft_ability_dodge_name": "Veteran Pilot Program",
    "imperial_strikecraft_ability_dodge_description": "The Empire has begun intensive new pilot programs designed to train existing and new pilots to better make use of the TIE line of strikecraft. Reports indicate trained pilots will be able to avoid point defense batteries with much greater success.",
    "imperial_venator_hangar_capacity_ability_name": "Carrier Doctrine",
    "imperial_venator_hangar_capacity_ability_description": "Opens the Venator's full flight deck and expands carrier operations, increasing its ability to launch, replace, and sustain strikecraft squadrons.",

    "imperial_planetary_shield_array_unit_item_name": "SDL-26 Planetary Shield Generator",
    "imperial_planetary_shield_array_unit_item_description": "A hold-over of previous tech used by the Galactic Empire; repurposed and refit with new materials found in this new universe. Casts a planet-wide defensive shield.",
    "unit_item_upkeep_reduction_name": "Advanced Logistics Protocols",
    "unit_item_upkeep_reduction_description": "Specialized protocols are enacted on the ship resulting in a marked decrease in resource waste and upkeep.",
    "unit_item_vrip_name": "V-RIP: Venator - Refit and Improvement Program",
    "unit_item_vrip_desc": "Service life extension program to improve the capabilities of the venerable Venator-class. This refit doubles the main battery of DBY-827 turbolasers, adds ion cannon emplacements towards the bow of the ship, and improves ship survivability.",
    "imperial_starbase_gravity_generator_unit_item_name": "Class-B Gravity Generator",
    "imperial_starbase_gravity_generator_unit_item_description": "With the use of new exotic materials, gravity well generators can now be installed on Class-B Outposts without any additional substantial power drain.",
    "imperial_specialization_offense_firing_speed_unit_item_name": "Rapid Fire Targeting Solutions",
    "imperial_specialization_offense_firing_speed_unit_item_description": "An algorithm enhancing the cycle rate of turbolasers and ion cannons for firing faster volleys on target and with faster target acquisition, but decreasing overall range and power.",
    "imperial_specialization_offense_damage_range_unit_item_name": "High-Output Focused Targeting Algorithm",
    "imperial_specialization_offense_damage_range_unit_item_description":"An algorithm that enhances first strike capabilities for turbolasers and ion cannons by decreasing the cycle rate of the power converters.",
    "imperial_specialization_offense_exploit_weakness_unit_item_name": "Enhanced Power Frequency Modulating Algorithm",
    "imperial_specialization_offense_exploit_weakness_unit_item_description": "An algorithm that allows for much greater fluctuation in turbolaser and ion cannon bolt frequency, allowing many shots to completely bypass the target's shields at the cost of fire rate and overall power output.",
    "imperial_specialization_defense_generator_unit_item_name": "Deflector Shield Integrity Matrix",
    "imperial_specialization_defense_hull_and_armor_item_unit_name": "Juggernaught Armor",
    "imperial_specialization_defense_hull_and_armor_item_unit_description": "New threats have emerged, requiring additional superstructure reinforcement of Imperial vessels. Deflector shields have proven to only partially protect against our new enemies.",
    "imperial_specialization_defense_generator_unit_item_description": "Deflector shield capacitors are continuously buffered, resulting in increased deflector integrity and an energy burst partially bringing failed shields back online. The energy burst requires a short delay as the deflector shield capacitors cycle their power.",
    "imperial_defense_culture_research_subject_name": "Military Parades",
    "imperial_defense_culture_research_subject_name_uppercase": "MILITARY PARADES",
    "imperial_defense_culture_research_subject_description": "Frequent mandatory military celebrations and parades ensure maximum messaging propagation to all sentients, foreign and domestic.",
    "imperial_deploy_starbase_unit_item_name": "Deploy Class-B Outpost",
    "imperial_deploy_starbase_unit_item_description": "Allows for the tactical deployment of a Class-B Outpost in a neutral or contested gravity well.",
    "imperial_gas_harvester_unit_item_name": "Floating Gas Mining Colony",
    "imperial_gas_harvester_unit_item_description": "These floating cities, much like Cloud City on Bespin, are, in actuality, refineries. They filter the gases of the planet and extract usable materials for military and civilian projects.",
    "imperial_gas_crystalizer_unit_item_name": "Advanced Filtration Depot",
    "imperial_gas_crystalizer_unit_item_description": "Additional filtration systems are set in place with advanced construction techniques, allowing the slow accumulation of specialized exotic materials.",
    "imperial_strip_mining_unit_item_name": "Mining Guild Ore Crawlers",
    "imperial_strip_mining_unit_item_description": "The Galactic Empire is well acquainted with extracting planetary resources via brutal efficiency. Mining Guild ore crawlers are retrofitted to operate no matter the atmospheric environment.",
    "imperial_command_bunker_unit_item_name": "Imperial Stormtrooper Forward Garrison",
    "imperial_command_bunker_unit_item_description": "A stormtrooper detachment designed to bolster the defense of a given planet.",
    "imperial_crystal_mines_unit_item_name": "Crystal Pit Mining",
    "imperial_crystal_mines_unit_item_description": "The Mining Guild has been authorized to extract crystal ore deposits from deep within the planetary crust, bolstering the exploitation of crystalline planets.",
    "imperial_ferric_mines_unit_item_name": "Ferric Pit Mining",
    "imperial_ferric_mines_unit_item_description": "The Mining Guild has been authorized to extract ferric ore deposits from deep within the planetary crust, bolstering the exploitation of ferrous planets.",
    "imperial_kessel_mines_unit_item_name": "Kessel Mines Administration",
    "imperial_kessel_mines_unit_item_description": "Everything needs administrative infrastructure to operate efficiently. The re-educated yearn for the mines.",
    "imperial_homeworld_heart_of_the_galaxy_name": "Heart of the Galaxy",
    "imperial_homeworld_heart_of_the_galaxy_name_uppercase": "HEART OF THE GALAXY",
    "imperial_homeworld_heart_of_the_galaxy_description": "Though the Empire was cast from our original home, our legacy will not be one of defeat nor of mediocrity. Our leader will ensure our prosperity. Long live the Empire!",
    "imperial_orbital_targeting_computer_unit_item_name": "Orbital Targeting Computer",
    "imperial_orbital_targeting_computer_unit_item_description": "Specialized targeting computers capable of networking with allied ships are installed to increase the amount of devastation inflicted by our bombardments of enemy planets.",
    "imperial_emperors_will_unit_item_name": "Emperor's Will",
    "imperial_emperors_will_unit_item_description": "The very will of the Emperor extends his influence to far off planets, which only requires the presence of the Imperial Navy to take effect. Long live the Empire!",

    "imperial_auxiliary_supply_depot_unit_item_name": "Sector Axiliary Supply Depot",
