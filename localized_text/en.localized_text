    "imperial_dreadnought_name": "Dreadnought-class Heavy Cruiser",
    "imperial_dreadnought_name.garrison": "Garrison Dreadnought-class Heavy Cruiser",
    "imperial_dreadnought_description": "The Dreadnaught-class heavy cruiser is an older design that can take a massive beating before going down. A few of these cruisers are a match for most capital ships pound-for-pound.",
    "imperial_tonfalk_name": "Ton-Falk-class Escort Carrier",
    "imperial_tonfalk_name.garrison": "Garrison Ton-Falk-class Escort Carrier",
    "imperial_tonfalk_description": "The Ton-Falk-class Escort Carrier is a vessel that houses several starfighter squadrons, allowing it to provide fleets with additional starfighter support if necessary.",
    "imperial_venator_name": "Venator-class Star Destroyer",
    "imperial_venator_loot_name": "Venator Wreckage",
    "imperial_venator_description": "The Venator-class Star Destroyer was designed to ferry Clone starfighters and ground forces to the front. It is the fastest ship in the galaxy for it's size; however it's emphasis on starfighters and speed have resulted it in having comparably sub-par firepower.",
    "rep_venator_name": "Venator Mk.2-class Star Destroyer",
    "rep_venator_loot_name": "Venator Mk.2 Wreckage",
    "rep_venator_description": "Proponents of the Venator's design features have been successful in creating a far more offensively-focused version of the Venator. Featuring stronger shield generators, greater armor and hull integrity, and with Imperial Skunworks currently working on a modular retrofit to double the number of DBY-827 turbolaser turrets, the Venator Mk2 cements itself as a maneuverable Star Destroyer that can punch well above its class.",
    "imperial_mtc_name": "Modular Taskforce Cruiser (Repair)",
    "imperial_mtc_name.garrison": "Garrison Modular Taskforce Cruiser (Repair)",
    "imperial_mtc_description": "A relatively new addition to the Imperial Navy, the MTC fills the much-needed niche of fleet repair and fuel resupply.",
    "imperial_acclamator_name": "Acclamator-class Assault Ship",
    "imperial_acclamator_description": "The Acclamator-class assault ship is geared primarily towards planetary landings, but its light armament allows it to combat small vessels.",
    "imperial_acclamator_2_name": "Acclamator II-class Assault Ship",
    "imperial_acclamator_2_description": "The Acclamator II features increased speed and maneuverability over its predecessor. It also features additional medium turbolasers at the cost of some of the other weapon systems to cement its place as a front-line Imperial cruiser.",
    "imperial_indictor_name": "Indictor-class Corvette",
    "imperial_indictor_description": "One of the lightest and fastest ships in the Imperial Navy",
    "imperial_arquitens_name": "Arquitens-class Light Cruiser",
    "imperial_arquitens_name.garrison": "Garrison Arquitens-class Light Cruiser",
    "imperial_arquitens_description": "This frigate is used to supplement fleets and provide them with additional, expendable firepower.",
    "imperial_arquitens_command_name": "Arquitens-class Command Cruiser",
    "imperial_arquitens_command_description": "New sensor arrays and communication uplinks are installed in this nimble frigate, allowing for greater fire on target and response times.",
    "imperial_vigil_name": "Vigil-class Corvette",
    "imperial_vigil_name.garrison": "Garrison Vigil-class Corvette",
    "imperial_vigil_description": "The Vigil-class was created to replace the venerable, but aging, CR-90 Corvette.",
    "imperial_cr90_name": "CR-90 Corvette",
    "imperial_cr90_trade_ship_name": "CR-90 Supply Corvette",
    "imperial_cr90_name.garrison": "Garrison CR-90 Corvette",
    "imperial_cr90_description": "An older, but extremely nimble, civilian corvette that was moderately armed for its size. Pressed into active military service by the Empire.",
    "imperial_cr90_trade_ship_description": "An older, but extremely nimble, civilian corvette that was moderately armed for its size. Pressed into supporting the Empire's military industrial complex.",
    "imperial_vindicator_name": "Vindicator-class Heavy Cruiser",
    "imperial_vindicator_name.garrison": "Garrison Vindicator-class Heavy Cruiser",
    "imperial_vindicator_description": "The Vindicator-class heavy cruiser was originally designed to protect trade lanes in the outer rim from pirates and rebels. It now serves the Empire as a front-line vessel along with the Dreadnought-class heavy cruiser.",
    "imperial_victoryii_name": "Victory II-class Star Destroyer",
    "imperial_victoryii_loot_name": "Victory II Wreckage",
    "imperial_victoryii_name.garrison": "Garrison Victory II-class Star Destroyer",
