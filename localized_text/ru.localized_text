    "sw_constructor_ship_name": "Y-45 Орбитальный транспортник",
    "sw_constructor_ship_description": "Гражданский орбитальный фрегат, оснащенный множеством монтажных инструментов, возводит сооружения в пределах досягаемости от планеты.",
    "sw_trade_complex_name": "Торговый комплекс Карден",
    "sw_trade_complex_description": "Стройте торговые порты, чтобы увеличить количество точек экспорта по всему государству и увеличить количество видов экспорта. Распределяйте точки экспорта между типами экспорта, чтобы настроить свою экономику. Товары увеличивают доход от кредитов, в то время как металл и кристаллы увеличивают доход от ресурсов.",

    "imperial_faction_victory_unit_item_name": "Имперское превосходство",
    "imperial_faction_victory_unit_item_description": "Сам император восседает на своем троне в рубке управления. Все склонятся перед мощью этой полностью вооруженной и боеспособной боевой станции.",
    "imperial_unlock_faction_victory_item_research_subject_name": "Имперское превосходство",
    "imperial_unlock_faction_victory_item_research_subject_name_uppercase": "ИМПЕРСКОЕ ПРЕВОСХОДСТВО",
    "imperial_allegiance_power_surge_ability_name": "Прототип защитного устройства с избыточным зарядом",
    "imperial_allegiance_power_surge_ability_description": "Верность - самый мощный корабль, который может выставить Империя, поэтому его необходимо защищать. Новый прототип защитной системы был разработан с использованием вражеских технологий и превосходных имперских разработок. Хотя у линейного крейсера все еще есть запасы антивещества, его щиты останутся мощными.",
    "imperial_venator_sphat_ability_name": "СТАУ-Т",
    "imperial_garrison_ability_name": "Отправить гарнизон",
    "imperial_garrison_ability_description": "Пошлите отряд штурмовиков для обеспечения соблюдения имперских законов на планете.",
    "imperial_power_weapons_ability_name": "Направить энергию на орудия",
    "imperial_power_weapons_ability_description": "Перенаправить энергию со щитов для быстрой перезарядки орудий.",
    "imperial_jump_disruption_ability_name": "Генератор гравитационного колодца",
    "imperial_jump_disruption_ability_description": "Воздействует на гипердвигатели вражеских кораблей, находящихся в этом гравитационном колодце, не давая им совершить гиперпрыжок.",
    "ability_ion_blast_name": "Ионный выстрел",
    "ability_ion_blast_desc": "Концентрированный ионный заряд высокой интенсивности, который на некоторое время выведет из строя вражеское судно.",
    "imperial_base_delta_zero_ability_name": "База Дельта Ноль",
    "imperial_base_delta_zero_ability_description": "Орбитальная бомбардировка до полного уничтожения сопротивления.",
    "imperial_research_lab_structure_phase_lane_detector_ability_name": "Протоколы раннего оповещения ИСБ",
    "imperial_research_lab_structure_phase_lane_detector_ability_description": "Имперское бюро безопасности отслеживает субсветовую и гиперпространственную связь, чтобы обнаружить приближающиеся вражеские военные корабли.",
    "imperial_flak_splash_item_name": "Зенитные орудия",
    "imperial_flak_splash_unit_item_description": "Зенитные пушки с разрывными снарядами, начиненными дюрастиловыми шашками, с легкостью сбивают истребители и приближающиеся ракеты.",
    "imperial_pelta_shield_projection_ability_name": "Проектор дефлекторного щита",
    "imperial_pelta_shield_projection_ability_description": "Пельта использует специализированные дефлекторные проекторы как для усиления защиты кораблей вокруг себя, так и для разделения входящего урона с помощью собственных дефлекторных щитов.",
    "imperial_arquitens_command_center_ability_name": "Эффективные боевые алгоритмы",
    "imperial_arquitens_command_center_ability_description": "Командный крейсер Арквитенс оснащен специализированными системами наведения на цель. Все корабли, находящиеся в пределах досягаемости, объединяют свои вычислительные мощности для более эффективного нанесения ударов по цели, а также возвращают избыточную неиспользуемую энергию в запасы антивещества каждого корабля.",
    "imperial_strikecraft_ability_dodge_name": "Летная программа для ветеранов",
    "imperial_strikecraft_ability_dodge_description": "Империя приступила к реализации новых интенсивных летных программ, направленных на обучение действующих и новых пилотов тому, как лучше использовать возможности их машин. В отчетах указывается, что подготовленные пилоты смогут с гораздо большим успехом обходить батареи точечной обороны.",
    "imperial_venator_hangar_capacity_ability_name": "Доктрина авианосца",
    "imperial_venator_hangar_capacity_ability_description": "Открывает главную летную палубу Венатора и расширяет возможности авианосца, повышая его способность запускать, заменять и поддерживать эскадрильи малых кораблей.",

    "imperial_planetary_shield_array_unit_item_name": "Генератор планетарного щита SDL-26",
    "imperial_planetary_shield_array_unit_item_description": "Наследие прежних технологий, использовавшихся Галактической империей. Переработано и оснащено новыми материалами, найденными в этой новой вселенной. Создает защитный щит для всей планеты..",
    "unit_item_upkeep_reduction_name": "Усовершенствованные логистические протоколы",
    "unit_item_upkeep_reduction_description": "На корабле отключены специализированные протоколы, что приводит к заметному сокращению потерь ресурсов и затрат на техническое обслуживание.",
    "unit_item_vrip_name": "V-RIP: Программа переоборудования и усовершенствования Венатора",
    "unit_item_vrip_desc": "Программа продления срока службы для улучшения возможностей легендарного класса Венатор. Это переоснащение удваивает количество основных батарей турболазеров DBY-827 и ионных пушек, расположенных в носовой части корабля, и повышает живучесть корабля.",
    "imperial_starbase_gravity_generator_unit_item_name": "Гравитационный генератор Класса Б",
    "imperial_starbase_gravity_generator_unit_item_description": "Благодаря использованию новых экзотических материалов генераторы гравитационных колодцев теперь можно устанавливать на Аванпостах класса Б без каких-либо дополнительных существенных затрат электроэнергии.",
    "imperial_specialization_offense_firing_speed_unit_item_name": "Алгоритмы быстрого наведения огня на цель",
    "imperial_specialization_offense_firing_speed_unit_item_description": "Алгоритм, повышающий частоту использования турболазеров и ионных пушек для более быстрого залпа по цели с более быстрым обнаружением цели, но снижающий общую дальность и мощность.",
    "imperial_specialization_offense_damage_range_unit_item_name": "Алгоритмы высокоэффективного фокусирования на цели",
    "imperial_specialization_offense_damage_range_unit_item_description":"Алгоритм, который увеличивает урон первого выстрела турболазеров и ионных пушек за счет уменьшения скорострельности.",
    "imperial_specialization_offense_exploit_weakness_unit_item_name": "Усовершенствованный алгоритм частотной модуляции мощности",
    "imperial_specialization_offense_exploit_weakness_unit_item_description": "Алгоритм, который допускает гораздо большие колебания частоты выстрелов из турболазеров и ионных пушек, позволяя многим выстрелам полностью обходить щиты цели за счет снижения скорострельности и общей выходной мощности.",
    "imperial_specialization_defense_generator_unit_item_name": "Матрица целостности дефлекторного щита",
    "imperial_specialization_defense_hull_and_armor_item_unit_name": "Броня Джаггернаут",
    "imperial_specialization_defense_hull_and_armor_item_unit_description": "Возникают новые угрозы, требующие дополнительного усиления надстроек имперских кораблей. Дефлекторные щиты, как оказалось, лишь частично защищают от этого врага.",
    "imperial_specialization_defense_generator_unit_item_description": "Конденсаторы дефлекторного щита постоянно буферизуются, что приводит к повышению целостности дефлектора и частичному восстановлению работоспособности вышедших из строя проекторов. Для восстановления работоспособности требуется небольшая задержка, поскольку конденсаторы дефлекторного щита перерабатывают энергию.",
    "imperial_defense_culture_research_subject_name": "Военные парады",
    "imperial_defense_culture_research_subject_name_uppercase": "ВОЕННЫЕ ПАРАДЫ",
    "imperial_defense_culture_research_subject_description": "Частые обязательные военные торжества и парады обеспечивают максимальное распространение информации среди всех разумных существ Галактики.",
    "imperial_deploy_starbase_unit_item_name": "Разместить Аванпост Класса Б",
    "imperial_deploy_starbase_unit_item_description": "Позволяет тактически разместить Аванпост Класса Б в нейтральной или оспариваемой системе.",
    "imperial_gas_harvester_unit_item_name": "Парящая колония по добыче газа",
    "imperial_gas_harvester_unit_item_description": "Эти парящие города, очень похожие на Облачный город на Беспине, на самом деле являются топливоперерабатывающими заводами. Они фильтруют газы планеты и извлекают полезные материалы для использования в военных и экономических проектах.",
    "imperial_gas_crystalizer_unit_item_name": "Усовершенствованное хранилище для фильтрации",
    "imperial_gas_crystalizer_unit_item_description": "Дополнительные системы фильтрации устанавливаются с использованием передовых строительных технологий, что позволяет медленно накапливать специализированные экзотические материалы.",
    "imperial_strip_mining_unit_item_name": "Краулеры Гильдии Рудодобытчиков",
    "imperial_strip_mining_unit_item_description": "Галактическая Империя хорошо знакома с технологией добычи планетарных ресурсов с невероятной эффективностью. Краулеры Гильдии Рудодобытччиков переоборудованы для работы в любых атмосферных условиях.",
    "imperial_command_bunker_unit_item_name": "Передовой гарнизон имперских штурмовиков",
    "imperial_command_bunker_unit_item_description": "Подразделение штурмовиков, созданное для усиления обороны данной планеты.",
    "imperial_crystal_mines_unit_item_name": "Добыча кристаллов в карьерах",
    "imperial_crystal_mines_unit_item_description": "Шахтерская Гильдия получила разрешение на добычу кристаллической руды глубоко в недрах планетарной коры, что способствует эксплуатации кристаллических планет.",
    "imperial_ferric_mines_unit_item_name": "Добыча металлов в карьерах",
    "imperial_ferric_mines_unit_item_description": "Шахтерская Гильдия получила разрешение на добычу залежей металлических руд глубоко в недрах планетарной коры, что способствует разработке месторождений металла на планетах.",
    "imperial_kessel_mines_unit_item_name": "Администрация шахт Кесселя",
