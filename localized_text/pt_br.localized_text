    "imperial_executor_sector_command_ability_name": "Sector Command",
    "imperial_executor_sector_command_ability_description": "Asserts operational control over the gravity well. Allied ships gain weapon cooldown reduction, weapon tracking, movement speed, and turn rate, while enemy ships suffer reduced antimatter regeneration, movement speed, and turn rate.",
    "imperial_executor_sector_command_allied_aura_name": "Sector Command",
    "imperial_executor_sector_command_enemy_debuff_name": "Sector Command",
    "imperial_executor_imperial_hegemony_ability_name": "Imperial Hegemony",
    "imperial_executor_imperial_hegemony_ability_description": "Passively improves allied fleet weapon cooldown reduction, shield regeneration, antimatter regeneration, and hull regeneration within the gravity well. Activate to greatly increase allied combat efficiency while reducing enemy weapon performance and maneuverability.",
    "imperial_executor_imperial_hegemony_enemy_debuff_name": "Imperial Hegemony",
    "imperial_executor_operational_logistics_ability_name": "Operational Logistics",
    "imperial_executor_assault_operations_ability_name": "Assault Operations",
    "imperial_executor_strategic_operations_ability_name": "Strategic Operations",
    "imperial_executor_strategic_operations_enemy_debuff_name": "Strategic Operations",
    "imperial_executor_operational_logistics_unit_item_name": "Operational Logistics",
    "imperial_executor_operational_logistics_unit_item_description": "Configures the Executor as the logistical center of the Imperial war machine, increasing antimatter regeneration, shield regeneration, hull regeneration, and phase jump charge rate. Replaces Imperial Hegemony with Operational Logistics.",
    "imperial_executor_assault_operations_unit_item_name": "Assault Operations",
    "imperial_executor_assault_operations_unit_item_description": "Configures the Executor for maximum offensive fleet operations, improving turbolaser, ion, concussion missile, and proton torpedo weapon damage, range, tracking, and cooldown reduction. Replaces Imperial Hegemony with Assault Operations.",
    "imperial_executor_strategic_operations_unit_item_name": "Strategic Operations",
    "imperial_executor_strategic_operations_unit_item_description": "Configures the Executor for long-duration command and battlefield control, increasing antimatter capacity, antimatter regeneration, maximum hull, and maximum shields. Replaces Imperial Hegemony with Strategic Operations.",
    "imperial_death_star_operations_ability_name": "Operational Readiness",
    "imperial_death_star_operations_ability_description": "The Death Star's operational configuration changes according to the installed command package. Without a configuration item, Operational Readiness improves shield regeneration, hull regeneration, antimatter regeneration, weapon cooldown reduction, and weapon tracking.",
    "imperial_death_star_damage_control_readiness_buff_name": "Damage Control Readiness",
    "imperial_death_star_target_saturation_buff_name": "Target Saturation",
    "imperial_death_star_operational_readiness_ability_name": "Operational Readiness",
    "imperial_death_star_battlestation_alert_ability_name": "Battlestation Alert",
    "imperial_death_star_total_fire_control_ability_name": "Total Fire Control",
    "imperial_death_star_doctrine_of_fear_ability_name": "Doctrine of Fear",
    "imperial_death_star_battlestation_operations_ability_name": "Battlestation Operations",
    "imperial_death_star_weapons_operations_ability_name": "Weapons Operations",
    "imperial_death_star_peacekeeping_operations_ability_name": "Peacekeeping Operations",
    "imperial_death_star_coercive_presence_ability_name": "Coercive Presence",
    "imperial_death_star_coercive_presence_active_ability_name": "Coercive Presence",
    "imperial_death_star_systemic_terror_ability_name": "Systemic Terror",    
    "imperial_death_star_battlestation_operations_unit_item_name": "Battlestation Operations",
    "imperial_death_star_battlestation_operations_unit_item_description": "Configures the Death Star for maximum defensive capability, increasing maximum hull, maximum shields, armor, hull regeneration, and shield regeneration. Replaces Operational Readiness with Battlestation Alert.",
    "imperial_death_star_weapons_operations_unit_item_name": "Weapons Operations",
    "imperial_death_star_weapons_operations_unit_item_description": "Configures the Death Star's conventional weapons for maximum fleet-combat performance, improving turbolaser, ion, and concussion weapon range, tracking, cooldown reduction, and damage. Replaces Operational Readiness with Total Fire Control.",
    "imperial_death_star_peacekeeping_operations_unit_item_name": "Peacekeeping Operations",
    "imperial_death_star_peacekeeping_operations_unit_item_description": "Configures the Death Star for strategic deployment, planetary subjugation, and the maintenance of Imperial order, increasing antimatter capacity, antimatter regeneration, movement speed, turn rate, and phase jump charge rate. Replaces Operational Readiness with Doctrine of Fear.",
    "imperial_death_star_battlestation_operations_mutation_name": "Battlestation Operations",
    "imperial_death_star_weapons_operations_mutation_name": "Weapons Operations",
    "imperial_death_star_peacekeeping_operations_mutation_name": "Peacekeeping Operations",
    "imperial_death_star_faction_victory_unit_item_description": "The Emperor himself sits upon his throne within the battlestation's command center. All will bow before the power of this fully armed and operational battlestation.",


    "imperial_dreadnought_name": "Cruzador Pesado Classe Dreadnought",
    "imperial_dreadnought_name.garrison": "Cruzador Pesado de Guarnição Classe Dreadnought",
    "imperial_dreadnought_description": "O cruzador pesado da classe Dreadnaught é um projeto mais antigo que pode suportar uma grande quantidade de danos antes de afundar. Alguns desses cruzadores são páreo para a maioria dos navios capitais, em termos de peso por peso.",
    "imperial_tonfalk_name": "Carrier Classe Ton-Falk",
    "imperial_tonfalk_name.garrison": "Carrier de Guarnição Classe Ton-Falk",
    "imperial_tonfalk_description": "A Carrier classe Ton-Falk é uma nave que abriga vários esquadrões de caças estelares, permitindo que ele forneça às frotas suporte adicional de caças estelares, se necessário.",
    "imperial_venator_name": "Star Destroyer Classe Venator",
    "imperial_venator_loot_name": "Destroços da Venator",
    "imperial_venator_description": "O Star Destroyer Classe Venator foi projetado para transportar caças estelares clones e forças terrestres para a linha de frente. É a nave mais rápida da galáxia para sua tonelagem, porém sua ênfase em caças estelares e velocidade resultou em um poder de fogo abaixo da média para seu tamanho.",
    "rep_venator_name": "Star Destroyer Classe Venator Mk.2 ",
    "rep_venator_loot_name": "Destroços da Venator Mk.2",
    "rep_venator_description": "Os defensores das características de design do Venator conseguiram criar uma versão muito mais ofensiva. Com geradores de escudo mais potentes, maior blindagem e integridade do casco, e com a Imperial Skunworks atualmente trabalhando em uma modernização modular para dobrar o número de torres turbolaser DBY-827, a Venator Mk2 se consolida como um Star Destroyer manobrável que pode superar em muito seu limite de peso.",
    "imperial_mtc_name": "Cruzador Modular Taskforce de Reparo",
    "imperial_mtc_name.garrison": "Cruzador de Guarnição Modular Taskforce de Reparo",
    "imperial_mtc_description": "Uma adição relativamente nova à Marinha Imperial, o CMT fornece um nicho muito necessário de material de reparo e reabastecimento de combustível.",
    "imperial_acclamator_name": "Cruzador de Assalto Classe Acclamator",
    "imperial_acclamator_description": "A nave de assalto da Classe Acclamator é voltada principalmente para pousos planetários, mas seu armamento leve permite que ela combata pequenas naves.",
    "imperial_acclamator_2_name": "Cruzador de Assalto Classe Acclamator II",
    "imperial_acclamator_2_description": "O Acclamator II apresenta maior velocidade e manobrabilidade em relação ao seu homólogo original. Ele também conta com turbolasers médios adicionais, em detrimento de outros sistemas de armas, para consolidar sua posição como um cruzador imperial de linha de frente.",
    "imperial_indictor_name": "Corveta Classe Indictor",
    "imperial_indictor_description": "Um dos navios mais leves e rápidos da Marinha Imperial",
    "imperial_arquitens_name": "Fragata Leve Classe Arquitens",
    "imperial_arquitens_name.garrison": "Fragata Leve de Guarnição Classe Arquitens",
    "imperial_arquitens_description": "Esta fragata é usada para complementar frotas e fornecer-lhes poder de fogo adicional e descartável.",
    "imperial_arquitens_command_name": "Fragata de Comando Classe Arquitens",
    "imperial_arquitens_command_description": "Novos conjuntos de sensores e uplinks de comunicação são instalados na ágil fragata, permitindo maior alcance de tiro ao alvo e tempos de resposta maiores.",
    "imperial_vigil_name": "Corveta Classe Vigil",
    "imperial_vigil_name.garrison": "Corveta de Guarnição Classe Vigil",
    "imperial_vigil_description": "A classe Vigil foi criada para substituir o venerável, mas antigo, Corvette CR-90.",
    "imperial_cr90_name": "Corveta CR-90",
    "imperial_cr90_trade_ship_name": "Corveta de Suprimentos CR-90",
    "imperial_cr90_name.garrison": "Corveta de Guarnição CR-90",
    "imperial_cr90_description": "Uma corveta civil mais antiga, mas extremamente ágil, com armamento moderado para seu tamanho. Pressionada para o serviço militar ativo pelo Império.",
    "imperial_cr90_trade_ship_description": "Uma corveta civil mais antiga, mas extremamente ágil, com armamento moderado para seu tamanho. Pressionada a dar suporte ao complexo industrial-militar do Império.",
    "imperial_vindicator_name": "Cruzador Pesado Classe Vindicator",
    "imperial_vindicator_name.garrison": "Cruzador Pesado de Guarnição Classe Vindicator",
    "imperial_vindicator_description": "O cruzador pesado da classe Vindicator foi originalmente projetado para proteger as rotas comerciais na orla externa contra piratas e rebeldes. Agora, serve ao Império como navio de linha de frente, juntamente com o cruzador pesado da classe Dreadnought.",
    "imperial_victoryii_name": "Star Destroyer Classe Victory II",
    "imperial_victoryii_loot_name": "Destroços do Victory II",
    "imperial_victoryii_name.garrison": "Star Destroyer de Guarnição Classe Victory II",
    "imperial_victoryii_description": "O Destróier Estelar classe Victory II é uma nave de guerra moderadamente armada e rápida, capaz de perseguir e manobrar a maioria das naves inimigas. Também é significativamente mais barato que os diversos Destróieres Estelares classe Imperial.",
    "imperial_victoryi_name": "Star Destroyer Classe Victory I",
    "imperial_victoryi_loot_name": "Destroços da Victory I",
    "imperial_victoryi_name.garrison": "Star Destroyer de Guarnição Classe Victory I",
    "imperial_victoryi_description": "O Star Destroyer classe Victory I era uma das naves capitais mais fortemente armadas da frota da República, um dos poucos Destróieres Estelares equipados com mísseis de concussão e usado para concentrar fogo em 1 ou 2 alvos de alta prioridade. No entanto, era extremamente lento devido aos seus propulsores iônicos de baixa potência.",
    "imperial_isd1_name": "Star Destroyer Classe Imperial I ",
    "imperial_isd1_loot_name": "Destroços da Imperial 1",
    "imperial_isd1_description": "O Star Destroyer classe Imperial I é uma nave de guerra pesada projetada para enfrentar diversas naves ao mesmo tempo e sobreviver a confrontos de grandes frotas.",
    "imperial_tector_name": "Star Destroyer Classe Tector",
    "imperial_tector_loot_name": "Destroços da Tector",
    "imperial_tector_description": "O Destróier Estelar classe Tector foi projetado para operar em conjunto com outras naves, devido à falta de um caça estelar, e disparar grandes volumes de fogo.",
    "imperial_isd2_name": "Star Destroyer Classe Imperial II",
    "imperial_isd2_loot_name": "Destroços da Imperial 2",
    "imperial_isd2_description": "O Star Destroyer classe Imperial II é uma atualização do ISD-I e desempenha uma função semelhante na frota Imperial.",
    "imperial_lancer_name": "Fragata Classe Lancer",
    "imperial_lancer_name.garrison": "Fragata de Guarnição Classe Lancer",
    "imperial_lancer_description": "As fragatas da classe Lancer são construídas especificamente para atravessar caças estelares e são as melhores naves anti-caças estelares da galáxia.",
    "imperial_velox_name": "Fragata Classe Velox",
    "imperial_velox_name.garrison": "Fragata de Guarnição Classe Velox",
    "imperial_velox_description": "A fragata classe Velox foi projetada para complementar e substituir em alguns casos a fragata classe Arquiten.",
    "imperial_tie_fighter_name": "Caça TIE",
    "imperial_tie_fighter_description": "Caças TIE/ln são baratos para produção em massa e são eficazes em grandes números.",
    "imperial_tie_interceptor_name": "TIE Interceptor",
    "imperial_tie_interceptor_description": "Interceptadores TIE/in mais rápidos e ágeis que os TIE/ln. Seu maior número de canhões laser permite que eles cortem caças e bombardeiros impunemente.",
    "imperial_tie_defender_name": "TIE Defender",
    "imperial_tie_defender_description": "Os caças TIE/D são caças avançados e eficazes de superioridade espacial. Seus escudos aumentam substancialmente a capacidade de sobrevivência dos pilotos, mas não podem ser utilizados em grandes números devido aos custos logísticos.",
    "imperial_tie_bomber_name": "Bombardeiro TIE",
    "imperial_tie_bomber_description": "Os bombardeiros TIE/sa são lentos e blindados, especializados em atacar instalações e grandes naves estelares.",
    "imperial_tr_galleon_name": "Galleon",
    "imperial_tr_galleon_description": "Galleon",
    "imperial_procursator_name": "Star Destroyer Classe Procursator ",
    "imperial_procursator_name.garrison": "Star Destroyer de Guarnição Classe Procursator ",
    "imperial_procursator_loot_name": "Destroços do Procursator",
    "imperial_procursator_description": "Um projeto pouco conhecido de Star Destroyer, retirado dos arquivos, com poder de fogo comparável ao dos ISDs mais recentes, mas com muito menos blindagem defensiva e blindagem. Todo projeto viável é necessário neste novo conflito.",
    "imperial_allegiance_name": "Cruzador de Batalha Classe Allegiance",
    "imperial_allegiance_loot_name": "Destroços da Allegiance",
    "imperial_allegiance_description": "Os cruzadores de batalha da classe Allegiance são navios de guerra poderosos com inúmeras baterias de armas e são otimizados para combates entre navios. É possível ter um total de 2 desses navios a qualquer momento.",
    "imperial_immobilizer_name": "Cruzador Classe Immobilizer 418",
    "imperial_immobilizer_description": "A Classe Immobilizer 418 é um Cruzador Classe Vindicator modificado. Possui quatro poderosos geradores de campo gravitacional, capazes de impedir que naves inimigas escapem para o hiperespaço. Além disso, seu armamento leve permite operações limitadas contra caças estelares e fragatas.",
    "imperial_interdictor_name": "Star Destroyer Classe Interdictor",
    "imperial_interdictor_description": "Star Destroyer Classe Interdictor",
    "imperial_gunpod_name": "Torre de Defesa Orbital",
    "imperial_gunpod_description": "Um módulo orbital barato, implantado para defender planetas de pequenas frotas. Originalmente equipado com duas torres turbolaser pesadas e quatro torres turbolaser médias, também pode ser equipado com pods de mísseis de concussão.",
    "imperial_starbase_name": "Posto Avançado Militar Classe B",
    "imperial_starbase_loot_name": "Destroços do Classe B",
    "imperial_starbase_description": "Embora o Império tenha muitos projetos de estruturas orbitais, o Posto Avançado Classe B tem o tamanho, a durabilidade, a potência e a modularidade necessários para defender qualquer poço gravitacional da maioria das ameaças.",
    
    "pirate_lucrehulk_name": "Battleship Classe Lucrehulk",
    "pirate_lucrehulk_loot_name": "Destroços do Lucrehulk",
    "pirate_lucrehulk_description": "Este cargueiro convertido está repleto de plataformas de armas e é o navio de guerra mais poderoso do arsenal da CEI. Também possui um hangar extremamente amplo, permitindo o deslocamento de um número substancial de caças e bombardeiros.",
    "pirate_munificent_name": "Fragata Classe Munificent",
    "pirate_munificent_description": "As fragatas estelares da classe Munificent são usadas para comunicações e guerra ECM e têm um enorme canhão Turbolaser na proa e um canhão de íons duplo que é letal contra alvos únicos, mesmo aqueles muito maiores que o Munificent.",
    "pirate_xx777_name": "Corveta XX-777",
    "pirate_xx777_description": "Também conhecido como triplo sete, o XX-777 é um navio favorito de piratas, organizações criminosas e combatentes pela liberdade.",
    "pirate_kihraxz_name": "Inteceptor Kihraxz",
    "pirate_kihraxz_description": "O Inteceptor Kihraxz é um interceptador rápido e durável, preferido por piratas e alguns combatentes pela liberdade.",
    "pirate_t62_name": "T62 Convor",
    "pirate_t62_description": "O precursor direto do T65 X-Wing da Incom. Apresentava motores e escudos aprimorados em relação ao Z-95 Headhunter, além de um conjunto de tubos de mísseis de concussão em cada asa para maior letalidade contra alvos difíceis.",
    "pirate_aggressor_name": "Aggressor-class Destroyer",
    "pirate_aggressor_loot_name": "Agressor-class Wreckage",
    "pirate_aggressor_description": "This destroyer was the underworld's answer to the Imperial Star Destroyer. It possesses two powerful dorsal plasma turbocannons giving it awesome alpha strike capabilities and sacrifices any potential hangar volume to field a greater number of turbolasers. It additionally has four twin barrel Mass Driver turrets for additional capital ship combat power.",
    "pirate_vengeance_name": "Vengeance-class Frigate",
    "pirate_vengeance_description": "A frigate in name only, this vessel possesses the firepower to punch well above its weight. Its two twin-linked gatling mass driver turrets have the ability to quickly rip through shields and hull alike.",
    "pirate_ysalamiri_name": "Ysalamiri-class cruiser",
    "pirate_ysalamiri_description": "An older Mando Motors design with an impressive array of firepower. It is more than a match for larger, newer ships with its powerful shields and numerous weapon systems.",
    "pirate_rill_name": "Rill-class Corvette",
    "pirate_rill_name.garrison": "Garrison Rill-class Corvette",
    "pirate_rill_description": "Mandal Motors built the Rill-class corvette to be the epitome of scouting and reconnaissance, while also possessing superior firepower for its class.",
    "pirate_keldabe_name": "Keldabe-class Battleship",
    "pirate_keldabe_loot_name": "Keldabe Wreckage",
    "pirate_keldabe_description": "A hybrid assault vessel, the Keldabe Battlecruiser merges the role of a heavy combatant with limited carrier support. Its design prioritizes sustained pressure and battlefield endurance, allowing it to overwhelm opponents through layered firepower and relentless engagement.",
    "pirate_mining_frigate_name": "HJ-45 Mining Frigate",
    "pirate_mining_frigate_name.garrison": "Garrison HJ-45 Mining Frigate",
    "pirate_mining_frigate_description": "A refitted mining vessel with a sturdy construction capable of forming the back-bone of a defense fleet, it is prized due to its relative cheap cost and semi-modular construction.",
    "pirate_bulwark_name": "Bulwark-Class Support Frigate",
    "pirate_bulwark_description": "Originally produced by SoroSuub Corporation as a modular convoy support platform, the Bulwark-class was rapidly adopted and modified by independent trade coalitions and syndicate fleets.",
    "pirate_deuteros_name": "Deuteros-class Cruiser",
    "pirate_deuteros_description": "Commissioned by Pantora to protect distant commercial interests, the Deuteros-class Cruiser combines exceptional firepower with long-range endurance. Surplus vessels have since found new life among independent traders and syndicate fleets seeking a warship capable of defending valuable cargo and projecting authority across contested space.",
    "pirate_rupture_name": "Rupture-class Support Cruiser",
    "pirate_rupture_description": "Originally developed with assistance from SoroSuub Corporation for long-range convoy support, the Rupture-class combines fleet coordination systems, disabling ion weaponry, and robust defensive armament. Its versatility and reliability have made it a favored support vessel among independent traders and syndicate fleets operating far from established authority.",

    "imperial_golan1_name": "Plataforma de Defesa Espacial Golan-1",
    "imperial_golan1_description": "A plataforma de defesa Golan-1 foi projetada para fornecer um poderoso hangar de defesa orbital com poder de fogo equivalente a um Destruidor Estelar.",
    "imperial_kontos_name": "Fragata Classe Kontos",
    "imperial_kontos_name.garrison": "Fragata de Guarnição Classe Kontos",
    "imperial_kontos_description": "As fragatas da Classe Kontos são uma pequena, porém poderosa, nova adição à Marinha Imperial. Elas possuem turbolasers potentes para alvos maiores e canhões laser para alvos menores e mais ágeis.",
    "imperial_gladiator_name": "Cruzador Gladiator",
    "imperial_gladiator_description": "A próxima evolução no design de porta-aviões imperiais, o Gladiator, é o sucessor do Venator. Embora classificado como um cruzador, ele mantém um amplo hangar e pode enfrentar navios da classe capital.",
    "imperial_pelta_name": "Fragata Classe Pelta",
    "imperial_pelta_name.garrison": "Fragata de Guarnição Classe Pelta",
    "imperial_pelta_description": "A fragata classe Pelta era o versátil carro-chefe da Marinha da Velha República, desempenhando diversas funções. Agora, foi readaptada para fornecer à Marinha Imperial o tão necessário apoio à frota e proteção contra caças, além de ser eficaz contra cruzadores menores e quaisquer fragatas que encontrasse.",
    "imperial_culture_center_structure_name": "Holonet Array",
    "imperial_culture_center_structure_description": "An orbital platform with the sole purpose of increasing pro-Imperial sentiment and suppressing misinformation.",

    "imperial_shipyard_name": "Estaleiro Orbital",
    "imperial_shipyard_description": "Permite a construção de corvetas, fragatas e cruzadores.",
    "imperial_heavy_shipyard_name": "Estaleiro Orbital Pesado",
    "imperial_heavy_shipyard_description": "Permite a construção de navios capitais",
    "imperial_death_star_name": "DS-1 Orbital Battle Station",
    "imperial_death_star_loot_name": "DS-1 Orbital Battle Station Wreckage",
    "imperial_death_star_description": "The DS-1, known also as the Death Star, is the pinnacle of Imperial Battlestation techology. It possesses equivalent firepower to an entire fleet and can obliterate planets with its Mark I superlaser. As kyber crystals cannot be found here in this new universe, the focusing crystals were replaced using new and powerful exotic materals.",
    "imperial_executor_name": "Executor-class Super Star Destroyer",
    "imperial_executor_loot_name": "Executor-class Super Star Destroyer Wreckage",
    "imperial_executor_description": "The ultimate form of the Empire's naval power. The Executor-class Super Star Destroyer serves not only as a iron fisted gauntlet to crush opposition, but as a mobile naval command capable of increasing the combat effectiveness of surrounding Imperial vessels.",
    "imperial_executor_pd_unit_item_name": "Aegis Defense Refit",
    "imperial_executor_pd_unit_item_description": "The Executor is reconfigured around a comprehensive close-defense doctrine, prioritizing layered point-defense coverage over offensive specialization. Extensive integration of tracking and fire-control systems transforms the vessel into a defensive bulwark, but limits the capacity for alternative armament refits.",
    "imperial_executor_ordinance_unit_item_name": "Heavy Ordinance Refit",
    "imperial_executor_ordinance_unit_item_description": "This refit commits the Executor to sustained missile warfare, expanding ordnance capacity and optimizing launch and reload systems for continuous bombardment. The scale of these modifications precludes other combat doctrines, binding the ship to a role centered on overwhelming missile saturation.",
    "imperial_executor_heavy_weapons_unit_item_name": "Linebreaker Refit",
    "imperial_executor_heavy_weapons_unit_item_description": "The Executor is fully committed to direct-fire dominance, with its superstructure and power systems optimized for maximum turbolaser output and accuracy. This specialization sacrifices flexibility in favor of raw destructive capability, preventing the integration of alternate refit doctrines.",
    "imperial_executor_cic_unit_item_name": "Battlegroup Coordination Suite",
    "imperial_executor_cic_unit_item_description": "Command, control, and flight operations are expanded to transform the Executor into a fleet coordination centerpiece. By dedicating internal volume and systems to strikecraft support and battlegroup management, the vessel forgoes other refit paths in favor of strategic force projection.",

    "imperial_assault_concussion_missile_name": "Míssil de Concussão de Assalto",
    "imperial_assault_concussion_missile_description": "Ogiva convencional grande e lenta.",
    "imperial_concussion_missile_name": "Míssil de Concussão",
    "imperial_concussion_missile_description": "Ogiva convencional pequena e rápida.",
    "imperial_proton_torpedo_name": "Torpedo de Prótons",
    "imperial_proton_torpedo_description": "Ogiva de energia média e lenta.",

    "player_ai_imp_taunt.1": "Behold the might of the Emperor's wrath — kneel or be ground into the hull plating of my Star Destroyer.",
    "player_ai_imp_taunt.2": "You bathe in the illusion of defiance. I will turn your final transmission into a warning that echoes across the quadrant — silence will be your epitaph.",
    "player_ai_imp_taunt.3": "You call yourselves masters of your own will. I call you targets. Prepare to be erased from the star charts.",
    "player_ai_imp_taunt.4": "Your ragged fleets are nothing but tinder for Imperial fire. Burn, little embers.",
    "player_ai_imp_taunt.5": "Darth Vader's shadow falls across you already. Run and you will only die tired.",
    "player_ai_imp_taunt.6": "Surrender now and you may die with a sliver of dignity. Resist and I will make your end a lesson.",
    "player_ai_imp_taunt.7": "We will claim this sector in the name of Emperor Palpatine. Your rebellion will be a footnote in Imperial history — a short, embarrassing one.",
    "player_ai_imp_taunt.8": "This is not negotiation; it is extermination. We bring peace — the rest of you bring only the sound of your own defeat.",
    "player_ai_imp_taunt.9": "Behold the wedge of my Star Destroyer — that silhouette is the Emperor's verdict. When our batteries unleash, your shields will crumble, your shelters will smolder, and your rebellion will be erased from every chart and memory.",
    "player_ai_imp_taunt.10": "Every system you infest, every rock you crawl beneath, the Empire will find you. I will scorch your worlds, shatter your fleets, and leave nothing but static where your defiance once screamed.",

    "player_ai_imp_alliance.1": "By the Emperor’s decree, this alliance is forged — not from trust, but necessity. Know this: when our purpose is fulfilled, you will kneel or be cast aside.",
    "player_ai_imp_alliance.2": "If Lord Vader commands unity, then unity you shall have — until the last rebel falls. After that, pray the Empire forgets your name.",
    "player_ai_imp_alliance.3": "The Emperor’s vision transcends my own ambition. I will suffer this alliance… for now. But when his will is complete, only the Empire shall remain.",

    "player_ai_imp_bounty_taunt.0": "By decree of the Imperial High Command, a bounty has been issued against {}. Let the lawless of this sector busy themselves with your correction.",
    "player_ai_imp_bounty_taunt.1": "The Empire has allocated funds to encourage...independent aggression against {}. Your stability is no longer our concern.",
    "player_ai_imp_bounty_taunt.2": "{} has been designated a destabilizing influence. Local raiders have been incentivized accordingly.",
    "player_ai_imp_bounty_taunt.3": "I have foreseen your disruption, {}. The underworld merely carries out what fate has already decreed. -Emperor Palpatine",
    "player_ai_imp_bounty_taunt.4": "You mistake tolerance for weakness, {}. Let us see how you fare when chaos turns its gaze upon you. -Emperor Palpatine",
    "player_ai_imp_bounty_taunt.5": "Disorder is a useful instrument. Today, {} will learn how useful. -Emperor Palpatine",
    "player_ai_imp_bounty_taunt.6": "{} will now contend with the consequences of Imperial attention. -Lord Vader",
    "player_ai_imp_bounty_taunt.7": "You will find your defenses tested, {}. We have encouraged the ambitious to do so. -Lord Vader",
    "player_ai_imp_bounty_taunt.8": "This action is not vengeance, {}. It is efficiency. -Lord Vader",
    "player_ai_imp_bounty_taunt.9": "Strategic funds have been reassigned. Raiders have been directed toward {} as a matter of priority.",
    "player_ai_imp_bounty_taunt.10": "Every empire believes itself secure, {}. Let us observe how long that illusion survives unchecked predation. -Emperor Palpatine",

