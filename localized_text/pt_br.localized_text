    "imperial_faction_victory_unit_item_name": "Imperial Supremacy",
    "imperial_faction_victory_unit_item_description": "The Emperor himself sits on his throne in the control room. All will bow before the power of this fully armed and operational battlestation.",
    "imperial_unlock_faction_victory_item_research_subject_name": "Imperial Supremacy",
    "imperial_unlock_faction_victory_item_research_subject_name_uppercase": "IMPERIAL SUPREMACY",
    "imperial_superlaser_ability_name": "Full Reactor Ignition",
    "imperial_superlaser_ability_desc": "The DS-1 Orbital Battlestation's massive antimatter annihilator reactors are momentarily overcharged to fill massive capacitors capable of holding at least a week's worth of output from a yellow dwarf star. This power is pushed through the power diversion solenoid and directed into the eight reactor lenses lining its large dish, firing a powerful beam capable of destroying the gravitational binding energy of a planet. These massive reactors also power a multitude of weapons systems and particularly resilient deflector shields. A hammer in a universe of nails.",
    "imperial_allegiance_power_surge_ability_name": "Protótipo de Matriz de sobrecarga de Escudo",
    "imperial_allegiance_power_surge_ability_description": "A Allegiance é a nave mais poderosa que o Império pode utilizar, portanto, precisa ser protegida. Um novo protótipo de conjunto de escudos foi desenvolvido utilizando tecnologia inimiga e designs imperiais superiores. Embora o cruzador de batalha ainda possua reservas de antimatéria, seus escudos permanecerão poderosos.",
    "imperial_venator_sphat_ability_name": "SPHA-T Turbolaser",
    "imperial_garrison_ability_name": "Planeta Guarnição",
    "imperial_garrison_ability_description": "Envie um destacamento de Stormtroopers para garantir a conformidade planetária com a Lei Imperial.",
    "imperial_power_weapons_ability_name": "Desviar poder para armas",
    "imperial_power_weapons_ability_description": "Redirecione a energia dos escudos para ciclar as armas mais rápido.",
    "imperial_jump_disruption_ability_name": "Gerador de Poço de Gravidade",
    "imperial_jump_disruption_ability_description": "Interfere nos hiperpropulsores das naves inimigas na área, impedindo que elas saltem para longe.",
    "ability_ion_blast_name": "Explosão de íons",
    "ability_ion_blast_desc": "Tiro de íons concentrado e de alta intensidade que incapacita uma nave inimiga por um tempo.",
    "imperial_base_delta_zero_ability_name": "Base Delta Zero",
    "imperial_base_delta_zero_ability_description": "Bombardeio orbital até que toda a resistência seja eliminada.",
    "imperial_research_lab_structure_phase_lane_detector_ability_name": "Protocolos de Alertas Antecipados do DSI",
    "imperial_research_lab_structure_phase_lane_detector_ability_description": "O Departamento de Segurança Imperial monitora as comunicações subaquáticas e hiperespaciais para detectar a chegada de naves de guerra hostis.",
    "imperial_flak_splash_item_name": "Canhões antiaéreos PD ",
    "imperial_flak_splash_unit_item_description": "Canhões antiaéreos com projéteis explosivos equipados com flechetes de durasteel para destruir caças estelares e mísseis com facilidade.",
    "imperial_pelta_shield_projection_ability_name": "Conjunto de Projetores de Escudo Defletor",
    "imperial_pelta_shield_projection_ability_description": "A classe Pelta usa conjuntos de defletores especializados para fortalecer a proteção das naves ao seu redor e também para dividir os danos recebidos com seus próprios escudos defletores.",
    "imperial_arquitens_command_center_ability_name": "Algoritmos de Combate Eficiente",
    "imperial_arquitens_command_center_ability_description": "A Fragata de Comando Arquitens é equipado com uplinks especializados em mira. Todas as naves dentro do alcance unem seu poder de processamento para direcionar os disparos ao alvo com mais eficácia, além de devolver o excesso de energia não utilizada às reservas de antimatéria de cada nave.",
    "imperial_strikecraft_ability_dodge_name": "Programa Piloto Veterano",
    "imperial_strikecraft_ability_dodge_description": "O Império iniciou novos programas intensivos de pilotagem, projetados para treinar pilotos novos e já existentes para melhor aproveitar a linha de ataque dos caças de ataque. Relatos indicam que pilotos treinados serão capazes de evitar baterias de defesa pontual com muito mais sucesso.",
    "imperial_venator_hangar_capacity_ability_name": "Carrier Doctrine",
    "imperial_venator_hangar_capacity_ability_description": "Opens the Venator's full flight deck and expands carrier operations, increasing its ability to launch, replace, and sustain strikecraft squadrons.",

    "imperial_planetary_shield_array_unit_item_name": "Gerador de Escudo Planetário SDL-26",
    "imperial_planetary_shield_array_unit_item_description": "Um resquício de tecnologia anterior usada pelo Império Galáctico. Reaproveitado e remodelado com novos materiais encontrados aqui neste novo universo. Cria um escudo defensivo que abrange todo o planeta.",
    "unit_item_upkeep_reduction_name": "Protocolos Logísticos Avançados",
    "unit_item_upkeep_reduction_description": "Protocolos especializados são implementados na nave, resultando em uma redução significativa no desperdício de recursos e na manutenção.",
    "unit_item_vrip_name": "V-RIP: Venator - Programa de Refit e Melhoria",
    "unit_item_vrip_desc": "Programa de extensão da vida útil para aprimorar as capacidades da venerável classe Venator. Esta reforma duplica a bateria principal dos turbolasers DBY-827, adiciona posições de canhões de íons na proa do navio e melhora a capacidade de sobrevivência do navio.",
    "imperial_starbase_gravity_generator_unit_item_name": "Gerador de Gravidade Classe B",
    "imperial_starbase_gravity_generator_unit_item_description": "Com o uso de novos materiais exóticos, geradores de poços gravitacionais agora podem ser instalados em Postos Avançados de Classe B sem qualquer consumo substancial de energia adicional.",
    "imperial_specialization_offense_firing_speed_unit_item_name": "Soluções de mira de tiro rápido",
    "imperial_specialization_offense_firing_speed_unit_item_description": "Um algoritmo que melhora a taxa de ciclo de turbolasers e canhões de íons para disparar rajadas mais rápidas no alvo com aquisição de alvo mais rápida, mas diminuindo o alcance e a potência geral.",
    "imperial_specialization_offense_damage_range_unit_item_name": "Algoritmo de Segmentação Focada de Alto Rendimento",
    "imperial_specialization_offense_damage_range_unit_item_description":"Um algoritmo que melhora a capacidade de primeiro ataque de turbolasers e canhões de íons ao diminuir a taxa de ciclo dos conversores de energia.",
    "imperial_specialization_offense_exploit_weakness_unit_item_name": "Algoritmo de Modulação de Frequência de Potência aprimorada",
    "imperial_specialization_offense_exploit_weakness_unit_item_description": "Um algoritmo que permite uma flutuação muito maior na frequência dos raios do Turbolaser e do Canhão de Íons, permitindo que muitos disparos ultrapassem completamente os escudos do alvo, em detrimento da taxa de tiro e da potência geral.",
    "imperial_specialization_defense_generator_unit_item_name": "Matriz de Integridade do Escudo Defletor",
    "imperial_specialization_defense_hull_and_armor_item_unit_name": "Armadura Juggernaught",
    "imperial_specialization_defense_hull_and_armor_item_unit_description": "Novas ameaças surgem, exigindo reforço adicional na superestrutura das naves imperiais. Escudos defletores demonstraram oferecer proteção apenas parcial contra esse inimigo.",
    "imperial_specialization_defense_generator_unit_item_description": "Os capacitores da blindagem defletora são continuamente armazenados em buffer, resultando em maior integridade do defletor e uma explosão de energia, que reativa parcialmente as blindagens com defeito. A explosão de energia requer um pequeno atraso enquanto os capacitores da blindagem defletora recarregam a energia.",
    "imperial_defense_culture_research_subject_name": "Desfiles Militares",
    "imperial_defense_culture_research_subject_name_uppercase": "DESFILES MILITARES",
    "imperial_defense_culture_research_subject_description": "Celebrações e desfiles militares obrigatórios e frequentes garantem a máxima propagação da mensagem a todos os seres sencientes, estrangeiros ou nacionais.",
    "imperial_deploy_starbase_unit_item_name": "Implantar Posto Avançado de Classe B",
    "imperial_deploy_starbase_unit_item_description": "Permite a implantação tática de um Posto Avançado Classe B em um poço de gravidade neutro ou contestado.",
    "imperial_gas_harvester_unit_item_name": "Colônia Flutuante Mineradora de Gás",
    "imperial_gas_harvester_unit_item_description": "Essas cidades flutuantes, assim como a Cidade das Nuvens em Bespin, são na verdade refinarias. Elas filtram os gases do planeta e extraem materiais utilizáveis ​​para projetos militares e econômicos.",
    "imperial_gas_crystalizer_unit_item_name": "Depósito de Filtração Avançada",
    "imperial_gas_crystalizer_unit_item_description": "Sistemas de filtragem adicionais são colocados em prática com técnicas de construção avançadas, permitindo o acúmulo lento de materiais exóticos especializados.",
    "imperial_strip_mining_unit_item_name": "Rastreadores da Guilda de Mineração",
    "imperial_strip_mining_unit_item_description": "O Império Galáctico está familiarizado com a extração de recursos planetários com eficiência brutal. Os rastreadores de minério da Guilda de Mineração são adaptados para operar independentemente do ambiente atmosférico.",
    "imperial_command_bunker_unit_item_name": "Guarnição Avançada de Stormtroopers Imperiais",
    "imperial_command_bunker_unit_item_description": "Um destacamento de stormtroopers projetado para reforçar a defesa de um determinado planeta.",
    "imperial_crystal_mines_unit_item_name": "Mineração de Poço de Cristal",
    "imperial_crystal_mines_unit_item_description": "A Guilda de Mineração foi autorizada a extrair depósitos de minério de cristal nas profundezas da crosta planetária, impulsionando a exploração de planetas cristalinos.",
    "imperial_ferric_mines_unit_item_name": "Mineração de Poço Férrico",
    "imperial_ferric_mines_unit_item_description": "A Guilda de Mineração foi autorizada a extrair depósitos de minério férrico nas profundezas da crosta planetária, impulsionando a exploração de planetas ferrosos.",
    "imperial_kessel_mines_unit_item_name": "Administração de Minas Kessel",
    "imperial_kessel_mines_unit_item_description": "Tudo precisa de infraestrutura administrativa para funcionar com eficiência. Os reeducados anseiam pelas minas.",
    "imperial_homeworld_heart_of_the_galaxy_name": "Coração da Galáxia",
    "imperial_homeworld_heart_of_the_galaxy_description": "Embora o Império tenha sido expulso de nossa terra natal, nosso legado não será de derrota ou mediocridade. Nosso líder garantirá nossa prosperidade. Vida longa ao Império!",
    "imperial_orbital_targeting_computer_unit_item_name": "Computador de Alvo Orbital",
    "imperial_orbital_targeting_computer_unit_item_description": "Computadores especializados em segmentação, capazes de se conectar em rede com naves aliadas, eles são instalados para aumentar a quantidade de devastação causada por nossos bombardeios em planetas inimigos.",
    "imperial_emperors_will_unit_item_name": "Vontade do Imperador",
    "imperial_emperors_will_unit_item_description": "A própria vontade do Imperador estende sua influência a planetas distantes, precisando apenas da presença da Marinha Imperial para surtir efeito. Vida longa ao Império!",

    "imperial_auxiliary_supply_depot_unit_item_name": "Sector Axiliary Supply Depot",
    "imperial_auxiliary_supply_depot_unit_item_description": "Establishes a dedicated supply hub to extend the operational range of auxiliary forces loyal to the Empire.",

