{
    "version": 0,
    "action_data_source": "imperial_victoryii_electronic_warfare_suite",
    "level_source": "internal_level",
    "min_required_unit_levels": [
        1,
        3,
        6,
        9
    ],
    "passive_actions": {
        "only_if_owner_unit_operational": true,
        "persistant_buff": "imperial_victoryii_electronic_warfare_suite_passive_on_hit"
    },
    "active_actions": {
        "cooldown_time": "imperial_victoryii_electronic_warfare_suite_cooldown_time_value",
        "antimatter_cost": "imperial_victoryii_electronic_warfare_suite_antimatter_cost_value",
        "actions": {
            "actions": [
                {
                    "action_type": "use_unit_operators_on_single_unit",
                    "destination_unit": {
                        "unit_type": "current_spawner"
                    },
                    "operators": [
                        {
                            "operator_type": "apply_buff",
                            "buff": "imperial_victoryii_electronic_warfare_suite_active_on_hit"
                        }
                    ]
                }
            ]
        },
        "auto_cast": {
            "enabled_by_default_behavior": "always",
            "caster_constraint": {
                "constraint_type": "unit_passes_unit_constraint",
                "unit": {
                    "unit_type": "current_spawner"
                },
                "unit_constraint": {
                    "constraint_type": "weapon_has_target",
                    "weapon_type": "normal"
                }
            }
        }
    },
    "gui": {
