{
    "version": 0,
    "action_data_source": "imperial_tector_fortified_defense",
    "level_source": "internal_level",
    "min_required_unit_levels": [
        0,
        2,
        5,
        8
    ],
    "passive_actions": {
        "only_if_owner_unit_operational": true,
        "persistant_buff": "imperial_tector_fortified_defense_passive_controller"
    },
    "active_actions": {
        "cooldown_time": "imperial_tector_fortified_defense_active_cooldown_time_value",
        "antimatter_cost": "imperial_tector_fortified_defense_active_antimatter_cost_value",
        "actions": {
            "actions": [
                {
                    "action_type": "use_unit_operators_on_single_unit",
                    "destination_unit": {
                        "unit_type": "current_spawner"
                    },
                    "operators": [
                        {
                            "operator_type": "apply_buff",
                            "buff": "imperial_tector_fortified_defense_active"
                        }
                    ]
                }
            ]
        },
        "auto_cast": {
            "enabled_by_default_behavior": "always",
            "caster_constraint": {
                "constraint_type": "unit_passes_unit_constraint",
                "unit": {
                    "unit_type": "current_spawner"
                },
                "unit_constraint": {
                    "constraint_type": "has_missing_shields",
                    "percentage_missing_threshold": 0.25
                }
            }
        }
    },
    "gui": {
        "hud_icon": "imperial_tector_fortified_defense_ability_hud_icon",
        "name": "imperial_tector_fortified_defense_ability_name",
        "description": "imperial_tector_fortified_defense_ability_description",
        "tooltip_line_groups": [
            {
                "lines": [
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.stack_duration",
                        "value_id": "imperial_tector_battle_hardened_duration_value",
                        "value_suffix": "seconds"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.ability.max_stack_count",
                        "value_id": "imperial_tector_battle_hardened_max_stack_count_value"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.damage_taken_per_stack",
                        "value_id": "imperial_tector_battle_hardened_damage_taken_value",
                        "value_float_format": "percentage_one_decimal_place",
                        "value_color": "positive"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.ability.active_duration",
                        "value_id": "imperial_tector_fortified_defense_active_duration_value",
                        "value_suffix": "seconds"
                    },
                    {
                        "rendering_type": "buff_unit_modifier",
                        "unit_modifier_id": "imperial_tector_fortified_defense_active_armor_regen_modifier"
                    },
                    {
                        "rendering_type": "buff_unit_modifier",
                        "unit_modifier_id": "imperial_tector_fortified_defense_active_hull_regen_modifier"
                    },
                    {
                        "rendering_type": "buff_unit_modifier",
                        "unit_modifier_id": "imperial_tector_fortified_defense_active_shield_regen_modifier"
                    }
                ]
            }
        ]
    }
}
