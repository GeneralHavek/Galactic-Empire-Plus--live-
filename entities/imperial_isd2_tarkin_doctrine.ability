{
    "version": 0,
    "action_data_source": "imperial_isd2_tarkin_doctrine",
    "level_source": "internal_level",
    "min_required_unit_levels": [
        4,
        7,
        9
    ],
    "passive_actions": {
        "only_if_owner_unit_operational": true,
        "persistant_buff": "imperial_isd2_tarkin_doctrine_passive_controller"
    },
    "active_actions": {
        "cooldown_time": "imperial_isd2_tarkin_doctrine_active_cooldown_time_value",
        "antimatter_cost": "imperial_isd2_tarkin_doctrine_active_antimatter_cost_value",
        "actions": {
            "actions": [
                {
                    "action_type": "use_unit_operators_on_single_unit",
                    "destination_unit": {
                        "unit_type": "current_spawner"
                    },
                    "operators": [
                        {
                            "operator_type": "apply_buff",
                            "buff": "imperial_isd2_tarkin_doctrine_active"
                        }
                    ]
                }
            ]
        },
        "auto_cast": {
            "enabled_by_default_behavior": "always",
            "caster_constraint": {
                "constraint_type": "unit_passes_unit_constraint",
                "unit": {
                    "unit_type": "current_spawner"
                },
                "unit_constraint": {
                    "constraint_type": "has_buff",
                    "buff": "imperial_isd2_imperial_ascendancy",
                    "include_pending_buffs": true
                }
            }
        }
    },
    "gui": {
        "hud_icon": "imperial_isd2_tarkin_doctrine_ability_hud_icon",
        "name": "imperial_isd2_tarkin_doctrine_ability_name",
        "description": "imperial_isd2_tarkin_doctrine_ability_description",
        "tooltip_line_groups": [
            {
                "lines": [
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.passive_weapon_damage_per_stack",
                        "value_id": "imperial_isd2_imperial_ascendancy_damage_value",
                        "value_float_format": "percentage",
                        "value_color": "positive"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.passive_weapon_tracking_per_stack",
                        "value_id": "imperial_isd2_imperial_ascendancy_tracking_value",
                        "value_float_format": "percentage",
                        "value_color": "positive"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.passive_weapon_cooldown_duration_per_stack",
                        "value_id": "imperial_isd2_imperial_ascendancy_cooldown_value",
                        "value_float_format": "percentage",
                        "value_color": "positive"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.passive_antimatter_restore_rate_per_stack",
                        "value_id": "imperial_isd2_imperial_ascendancy_antimatter_regen_value",
                        "value_float_format": "percentage",
                        "value_color": "positive"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.ability.max_stack_count",
                        "value_id": "imperial_isd2_imperial_ascendancy_stack_limit_value"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.ability.active_duration",
                        "value_id": "imperial_isd2_tarkin_doctrine_active_duration_value",
                        "value_suffix": "seconds"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.active_additional_weapon_damage",
                        "value_id": "imperial_isd2_tarkin_doctrine_active_damage_value",
                        "value_float_format": "percentage",
                        "value_color": "positive"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.active_additional_weapon_tracking",
                        "value_id": "imperial_isd2_tarkin_doctrine_active_tracking_value",
                        "value_float_format": "percentage",
                        "value_color": "positive"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.active_additional_weapon_cooldown_duration",
                        "value_id": "imperial_isd2_tarkin_doctrine_active_cooldown_value",
                        "value_float_format": "percentage"
                    },
                    {
                        "rendering_type": "buff_unit_modifier",
