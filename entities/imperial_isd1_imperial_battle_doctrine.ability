                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.label.active_additional_shield_restore_rate",
                        "value_id": "imperial_isd1_imperial_battle_doctrine_active_shield_regen_value",
                        "value_float_format": "percentage",
                        "value_color": "positive"
                    },
                    {
                        "rendering_type": "single_value",
