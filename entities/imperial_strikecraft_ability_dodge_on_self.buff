{
    "version": 0,
    "stacking_limit": {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "restart_other_stacked_buffs_when_started": false,
    "stacking_ownership_type": "for_all_players",
    "make_dead_on_current_spawner_made_dead": true,
    "trigger_event_actions": [
        {
            "trigger_event_type": "on_try_prevent_damage",
            "action_group": {
                "constraint": {
                    "constraint_type": "composite_and",
                    "constraints": [
                        {
                            "constraint_type": "unit_passes_unit_constraint",
                            "unit":
                            {
                                "unit_type": "current_spawner"
                            },
                            "unit_constraint": 
                            {
                                "constraint_type": "has_recently_been_damaged"
                            }
                        },
                        {
                            "constraint_type": "random_chance",
                            "chance_value": "strikecraft_dodge_chance_value"
                        }
                    ]
                },
                "actions": [
                    {
                        "action_type": "prevent_damage",
                        "damage_prevented_value": "strikecraft_dodge_damage_prevented_value"
                    }
                ]
            }
        }
    ],
    "gui": {
        "hud_icon": "imperial_strikecraft_ability_dodge_hud_icon",
        "name": "imperial_strikecraft_ability_dodge_name",
        "description": "imperial_strikecraft_ability_dodge_description",
        "tooltip_line_groups": [
            {
                "lines": [
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.ability.dodge_chance",
                        "value_id": "strikecraft_dodge_chance_value",
                        "value_float_format": "percentage",
                        "value_color": "positive"
                    }
                ]
            }
        ]
    }
}