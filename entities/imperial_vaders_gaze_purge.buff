{
    "version": 0,
    "active_duration": "vaders_gaze_purge_execution_duration_value",
    "stacking_limit": {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "replace_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
        {
            "trigger_event_type": "on_buff_started",
            "action_group": {
                "actions": [
                    {
                        "action_type": "use_unit_operators_on_single_unit",
                        "destination_unit": {
                            "unit_type": "current_spawner"
                        },
                        "operators": [
                            {
                                "operator_type": "remove_corruption",
                                "corruption_remove_value": "vaders_gaze_current_corruption_value",
                                "actual_removed_corruption_float_variable": "purged_corruption"
                            },
                            {
                                "operator_type": "apply_buff",
                                "buff": "imperial_vaders_gaze_aftermath",
                                "copy_parent_buff_memory_values": true
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
