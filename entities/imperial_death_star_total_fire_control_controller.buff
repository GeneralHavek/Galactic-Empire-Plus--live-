              {
                "operator_type": "apply_buff",
                "buff": "imperial_death_star_fire_distribution"
              },
              {
                "operator_type": "apply_buff",
                "buff": "imperial_death_star_fire_distribution_gate"
              }
            ]
          },
          {
            "constraint": {
