{
    "version": 0,
    "stacking_limit": {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
        {
            "execution_interval_value": "imperial_executor_imperial_resolve_passive_interval_value",
            "action_group": {
                "actions": [
                    {
                        "action_type": "use_unit_operators_on_units_in_radius_of_unit",
                        "radius_origin_unit": {
                            "unit_type": "current_spawner"
                        },
                        "radius_value": "imperial_executor_imperial_resolve_gravity_well_radius_value",
                        "include_radius_origin_unit": true,
                        "include_y_axis_in_radius_check": false,
                        "operators": [
                            {
                                "operator_type": "apply_buff",
                                "buff": "imperial_executor_imperial_resolve_passive_aura",
                                "destination_target_filter_id": "imperial_executor_imperial_resolve_allied_ship_target_filter"
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
